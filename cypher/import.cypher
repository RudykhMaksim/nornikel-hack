CREATE (:Entity:Publication {id: "doc_fa4c1ead72d3", name_ru: "PreciousMetalsQuarterly2009DecExecutive Summary.pdf", path: "Материалы конференций/Источники данных о МПГ/Квартальные издания/CRU/2009/Dec 2009/PreciousMetalsQuarterly2009DecExecutive Summary.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 92795, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Precious Metals Quarterly 2009 Q4  CRU International Limited confidential  Executive summary  Platinum market deficits: 2011-14  The platinum market should begin a period of gradual normalisation from 2010, after its  2009 dislocation.  We expect the physical market to return to a period of sustained deficits from 2011 for the  first time since the early 2000s, peaking at 510,000oz in 2012, befo", char_count: 11328});
