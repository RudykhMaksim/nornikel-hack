CREATE (:Entity:Publication {id: "doc_ea9e95d86b68", name_ru: "Ch-1_Consumption_&_Market_Trends.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-Wirerod-2008/Ch-1_Consumption_&_Market_Trends.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 5472618, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Copper Semis Service – Copper Wirerod     CRU International Limited confidential  Chapter 1  Consumption and  Market Trends  1.1 Methodology and General Themes  The consumption data in this chapter has been derived using a straightforward apparent  consumption methodology.  Therefore for every country and region consumption is: -     Production of copper wirerod  Minus exports of copper wirerod ", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_b0ee76163775", name_ru: "Ch-2_Trade.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-Wirerod-2008/Ch-2_Trade.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 9996902, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "Copper Semis Service – Copper Wirerod    Chapter 2 Developments in Trade  2 - 1  Chapter 2  Trade  1. Overview & Methodology  This chapter briefly reviews trends in international trade for the market segments of:   •  Copper Wirerod   •  Single Strand Copper Wire   •  Stranded Copper Wire  The latter two represent the two final processing stages before the wire is insulated which then  transformed", char_count: 20000});
