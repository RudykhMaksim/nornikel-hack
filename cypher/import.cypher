CREATE (:Entity:Publication {id: "doc_38e368d7b1c3", name_ru: "CopperMonitor2011Jul.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2011/CopperMonitor2011Jul.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 340991, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "July 2011        © 2011 CRU International Limited confidential  Looking to China   Copper prices traded in a tight range during June due to investor sentiment for  commodities remaining cautious and negative macroeconomic signals. However,  when the Greek austerity package was approved and the euro recovered, the 3- month LME price rose to over $9,350/t on 30th June. This is the highest price sin", char_count: 20000});
