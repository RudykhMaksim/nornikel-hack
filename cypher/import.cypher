CREATE (:Entity:Publication {id: "doc_a8291176a306", name_ru: "Доклад_Вострикова Н.М.pdf", path: "Доклады/Доклад_Вострикова Н.М.pdf", category: "Доклады", ext: "pdf", size_bytes: 1596112, sensitivity: "internal", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " 2 О курсе … | 2 Результат обучения  Ориентация в специфике производственной деятельности Компании, и ее интересах.  Применять полученные знания в процессе решения своих функциональных задач. Цель курса  ознакомление с основами производственного цикла получения готовой товарной продукции, производимой в нашей компании Эксперты Курс разработан в 2020 г коллективом экспертов Института Гипроникель", char_count: 6098});
CREATE (:Entity:Publication {id: "doc_1b4b58e205f3", name_ru: "Доклад_Вязовой О.Н.pdf", path: "Доклады/Доклад_Вязовой О.Н.pdf", category: "Доклады", ext: "pdf", size_bytes: 1062017, sensitivity: "internal", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ТЭР по вариантам реконфигурации  производства драгоценных металлов  КЛЮЧЕВАЯ ИНФОРМАЦИЯ ОПТИМИЗАЦИЯ ТЕХНИЧЕСКИХ РЕШЕНИЙ  «ТЭР ПО ВАРИАНТАМ РЕКОНФИГУРАЦИИ ПРОИЗВОДСТВА ДРАГОЦЕННЫХ МЕТАЛЛОВ» | 2 Оценка эффективности новой технологии переработки материалов ДМ с получением товарных  концентратов КПП и КМСП Цель 1. Анализ текущего состояния технологии производства концентратов ДМ, выбор перспективной  ", char_count: 5856});
CREATE (:Entity:Publication {id: "doc_4acdd3349093", name_ru: "Доклад_Луканина М.А.pdf", path: "Доклады/Доклад_Луканина М.А.pdf", category: "Доклады", ext: "pdf", size_bytes: 1776570, sensitivity: "internal", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "МАТЕМАТИЧЕСКОЕ  МОДЕЛИРОВАНИЕ ПРИ РЕШЕНИИ ЗАДАЧ  МЕТАЛЛУРГИЧЕСКОЙ  ПРОМЫШЛЕННОСТИ Научный сотрудник лаборатории пирометаллургии  Института Гипроникель Мария Луканина  ПРИМЕНЕНИЕ МАТЕМАТИЧЕСКОГО  МОДЕЛИРОВАНИЯ | 2 CFD – Вычислительная гидродинамика. Метод основан на  решении уравнений движения и теплопереноса в  жидкостях, газах и твёрдых телах для каждой ячейки  пространства, разбитого на множеств", char_count: 2868});
