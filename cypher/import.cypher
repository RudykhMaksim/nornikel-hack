CREATE (:Entity:Publication {id: "doc_916fe810ff45", name_ru: "ЦМ №12-2018.pdf", path: "Журналы/Цветные металлы/2018-все/ЦМ №12-2018.pdf", category: "Журналы", ext: "pdf", size_bytes: 4235826, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Уважаемые читатели и коллеги!  Двенадцатый номер журнала «Цветные металлы» завершает  годовой цикл, поэтому в первую очередь хотелось бы отметить  отличную работу всех, кто вовлечен в издание журнала. Благодаря  слаженному взаимодействию редакции и авторов у нас есть воз- можность быть в курсе научных изысканий и разноплановых дости- жений, которыми изобилует каждый выпуск журнала. Сегодня научны", char_count: 20000});
