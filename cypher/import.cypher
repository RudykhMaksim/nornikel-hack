CREATE (:Entity:Publication {id: "doc_a4ed9ad29158", name_ru: "ЦМ №10-2018.pdf", path: "Журналы/Цветные металлы/2018-все/ЦМ №10-2018.pdf", category: "Журналы", ext: "pdf", size_bytes: 6066535, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Уважаемые читатели и коллеги! Осень традиционно богата на события научной и обществен- ной жизни, среди которых заметное место занимает 21 октября  (1 ноября по новому стилю) 1773 г. — дата, на которую прихо- дится подписание Екатериной II указа об учреждении в Санкт- Петербурге первого высшего технического учебного заведения —  Горного училища. С этих пор его название неоднократно  изменялось, ч", char_count: 20000});
