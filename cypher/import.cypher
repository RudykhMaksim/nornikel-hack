CREATE (:Entity:Publication {id: "doc_2a2250e37d2f", name_ru: "CopperQuarterly2010OctExecSum.xls", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperQuarterly2010OctData.zip::CopperQuarterly2010OctExecSum.xls", category: "Материалы конференций", ext: "xls", size_bytes: 107520, sensitivity: "public", confidence: "verified", deep_parsed: false, geography: "International"});
CREATE (:Entity:Publication {id: "doc_54f782f89c36", name_ru: "CopperQuarterly2010OctExecSum.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperQuarterly2010OctExecSum.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 349743, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Copper Quarterly October 2010  CRU International Limited confidential  Executive Summary  Copper flying to a new all-time high   Sentiment was universally bullish throughout LME week and prices have continued to  build on the recovery of the past few months.  Investment inflows into commodities and  copper rebounded in September, supported by both fundamental and macroeconomic  indicators.  Our", char_count: 20000});
