CREATE (:Entity:Publication {id: "doc_27356269f64e", name_ru: "NN3003.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN3003.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 184493, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 30th March 2009 Norilsk Nickel Daily News Digest GM CEO Rick Wagoner has resigned under pressure from the Obama administration, to be replaced by  COO Fritz Henderson. GM has 60 days to determine its future.  Chrysler will be given 30 days to complete  a proposed alliance with Fiat SpA.; if successful, it could receive up to $6 billion in new assistance. Source:  Automotive News  Toyota ", char_count: 4058});
