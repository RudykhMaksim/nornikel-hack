CREATE (:Entity:Publication {id: "doc_d825ed31e4aa", name_ru: "CM_02_13.pdf", path: "Журналы/Цветные металлы/2013/CM_02_13.pdf", category: "Журналы", ext: "pdf", size_bytes: 4695124, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " ДОРОГИЕ ДРУЗЬЯ! Смоленщина гордится тем, что на  территории региона действует такое  рентабельное и стратегически важное  предприятие, как завод «Кристалл».  Трудно переоценить его вклад в эко - но мику края, но еще более приятным  для нас, смолян, является тот факт, что благодаря  «Кристаллу» город-герой Смоленск известен и в  нашей стране, и за рубежом как столица бриллиан- тов России. Безуслов", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_b64ac96d86f8", name_ru: "CM_03_13.pdf", path: "Журналы/Цветные металлы/2013/CM_03_13.pdf", category: "Журналы", ext: "pdf", size_bytes: 3994603, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 3. 2013 Федеральное государственное бюджетное учреждение Институт металлургии Уральского отделения  Российской академии наук  ТЕРМИНОЛОГИЧЕСКИЙ СЛОВАРЬ ТЕРМИНОЛОГИЧЕСКИЙ СЛОВАРЬ ПО ОБОГАЩЕНИЮ РУД ПО ОБОГАЩЕНИЮ РУД     В словаре приведены термины (с переводом на  английский язык) и их значения по дезинтегра- ции руд, флотационным, гравитацион", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_8139b4d97bcb", name_ru: "CM_04_13.pdf", path: "Журналы/Цветные металлы/2013/CM_04_13.pdf", category: "Журналы", ext: "pdf", size_bytes: 4763711, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 4. 2013 В номере: Институту «Норильскпроект» ---  75 лет  (с. 29) Горно-геологическому университету  «Св. Иван Рилски» --- 60 лет  (с. 85)   Е Ж Е М Е С Я Ч Н Ы Й Н А У Ч Н О  Т Е Х Н И Ч Е С К И Й И П Р О И З В О Д С Т В Е Н Н Ы Й Ж У Р Н А Л 4 (844) •2013 Подписные индексы: 71060 (Роспечать) 83869 (ОК «Пресса России») апрель РЕДКОЛЛЕГИЯ: ", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_b96ebd4458ef", name_ru: "CM_05_13.pdf", path: "Журналы/Цветные металлы/2013/CM_05_13.pdf", category: "Журналы", ext: "pdf", size_bytes: 3488784, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "5. 2013 ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Ко Дню Победы: Музей военной техники «Боевая слава Урала» (с. 45)    Е Ж Е М Е С Я Ч Н Ы Й Н А У Ч Н О  Т Е Х Н И Ч Е С К И Й И П Р О И З В О Д С Т В Е Н Н Ы Й Ж У Р Н А Л Подписные индексы: 71060 (Роспечать) 83869 (ОК «Пресса России») май РЕДКОЛЛЕГИЯ: З. С. Абишева, А. А. Аксенов, Р. Х. Акчурин, П. Н. Алентов, М. В. Астахов (редакт", char_count: 20000});
