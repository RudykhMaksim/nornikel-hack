CREATE (:Entity:Publication {id: "doc_5388a8345c6f", name_ru: "CM_09_14.pdf", path: "Журналы/Цветные металлы/2014/CM_09_14.pdf", category: "Журналы", ext: "pdf", size_bytes: 4423979, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 9. 2014 Институту «Гипроникель» — 80 лет  Дорогие коллеги! В этот знаменательный день примите поздравления с 80-летним  юбилеем вашего института! Институт «Гипроникель» — один из немногих научно-проектных  институтов станы, бывших у истоков становления российской цвет- ной металлургии. Сама история создания Гипроникеля предопреде- лила его с", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_6aed13f6ce60", name_ru: "CM_10_14.pdf", path: "Журналы/Цветные металлы/2014/CM_10_14.pdf", category: "Журналы", ext: "pdf", size_bytes: 6288854, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 10. 2014  В преддверии Дня металлурга, 17 июля 2014 г. возле пар- ка УГМК состоялось открытие скульптурной композиции  «Первая руда». Композиция посвящена горнорудным рабо- чим, шахтерам, принимавшим участие в освоении первого  рудника в Верхней Пышме. Скульпьурная композиция вошла в архитектурный ан- самбль Парка УГМК. Эта оригинальная рабо", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_8efaa9aea111", name_ru: "CM_11_14.pdf", path: "Журналы/Цветные металлы/2014/CM_11_14.pdf", category: "Журналы", ext: "pdf", size_bytes: 5410023, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "• Государственному Эрмитажу — 250 лет • Разработки департамента гидрометаллургии ЗАО «НПО «РИВС»   (к научно-практической конференции «РИВС-2014») • Навстречу 90-летию журнала: воспоминания о Евгении Матвеевиче Бычкове ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 11. 2014 Н А У Ч Н О - П Р А К Т И Ч Е С К А Я   К О Н Ф Е Р Е Н Ц И Я   Р И В С   2 0 1 4  Ч етверть тысячелетия — достойны", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_e348d235087a", name_ru: "CM_12_14.pdf", path: "Журналы/Цветные металлы/2014/CM_12_14.pdf", category: "Журналы", ext: "pdf", size_bytes: 5130486, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 12. 2014  В ашему вниманию предлагается журнал «Цветные металлы»,  посвященный материаловедению энергонапряженной и,  прежде всего, атомной техники. Материаловедение как наука о  взаимосвязи свойств и структурно-фазового состояния матери- алов является базой для разработки новых материалов с задан- ными свойствами. Оно опирается на физику ко", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_3a054b4bb1dc", name_ru: "CM_01_15.pdf", path: "Журналы/Цветные металлы/2015/CM_01_15.pdf", category: "Журналы", ext: "pdf", size_bytes: 3248886, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 1. 2015 В номере: • Достижения и проблемы промышленной технологии получения серы из металлургических сернистых газов • Кинетика автоклавного окисления упорных золотосодержащих сульфидных концентратов • Механизм получения гидроксида алюминия в электролизере и коагуляция мелких частиц во время  седиментации в токопроводящих солевых растворах •", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_2afa1a5c4d25", name_ru: "CM_02_15.pdf", path: "Журналы/Цветные металлы/2015/CM_02_15.pdf", category: "Журналы", ext: "pdf", size_bytes: 2760446, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 2. 2015 В номере: • Новый раздел: «Материаловедение» • Институту «Гипроникель» — 80 лет • Разделение редкоземельных металлов жидкостной экстракцией • Недендритная кристаллизация металлических материалов (к 100-летию  В. И. Добаткина)  Подписка на 2015 г. Подписка на 2015 г. Редакция журнала «Цветные металлы» Россия, 119049, Москва, а/я 71  И", char_count: 20000});
