CREATE (:Entity:Publication {id: "doc_004fe489ee98", name_ru: "CM_08_13.pdf", path: "Журналы/Цветные металлы/2013/CM_08_13.pdf", category: "Журналы", ext: "pdf", size_bytes: 4400364, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 8. 2013 ЕЖЕМЕСЯЧНЫЙ ЕЖЕМЕСЯЧНЫЙ НАУЧНО ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Реклама  Уважаемые друзья! Поздравляю вас с открытием Технического университе- та  УГМК!  Подготовка  профессиональных  инженерных  кадров — это необходимое условие успешной модерни- зации и инновационного развития эконом", char_count: 20000});
