CREATE (:Entity:Conclusion {id: "concl_mettop_brx_effect", name_ru: "Технология параллельных потоков (METTOP-BRX) увеличивает плотность тока до 400-420 А/м2 (рост до 50%) за счёт усиления конвекции электролита у катода, без ухудшения качества катодного осадка", name_en: "Parallel-flow technology (METTOP-BRX) raises current density to 400-420 A/m2 (up to 50% increase) via enhanced catholyte convection at the cathode, without degrading cathode quality", geography: "International", confidence: "verified", last_updated: "2025-01-01"});
CREATE (:Entity:Conclusion {id: "concl_ni_matte_slag_understudied", name_ru: "Современных, тщательно поставленных работ по распределению благородных металлов между никелевым штейном и шлаком значительно меньше, чем по медному штейну", name_en: "Modern, carefully controlled studies on noble-metal distribution between nickel matte and slag are far scarcer than for copper matte", geography: "Global", confidence: "verified", last_updated: "2018-01-01"});
