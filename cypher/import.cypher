CREATE (:Entity:Publication {id: "doc_2d5a7f08dc2c", name_ru: "CopperMonitor2011Jun.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2011/CopperMonitor2011Jun.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 315963, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "June 2011        © 2011 CRU International Limited confidential  Macro dictates   The uncertain macro economic outlook offers little incentive for any inventory  building through the consumption chain.  This is now the sixth consecutive month of  increase in total LME inventories.  Over the past two days, inflows into LME  warehouses have continued, up by 5,725t to 473,500t.  LME stocks are now ba", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_e0df33c42477", name_ru: "CopperMonitor2011Mar.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2011/CopperMonitor2011Mar.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 346192, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "March 2011        © 2011 CRU International Limited confidential  A consumers’ strike   The LME 3-month copper price hit $10,160/t on 14th February, driven by positive  economic news and sustained Chinese imports.  Prices then dropped by more than  3% in two days late in the month, as market sentiment was dampened by the unrest  in Africa & the Middle East and fears related to higher oil prices.  ", char_count: 20000});
