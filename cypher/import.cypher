CREATE (:Entity:Publication {id: "doc_22193d44eaa2", name_ru: "ОР № 02-23.pdf", path: "Журналы/Обогащение руд/2023/ОР № 02-23.pdf", category: "Журналы", ext: "pdf", size_bytes: 4947265, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " СОВРЕМЕННОСТЬ — ЧЕРЕЗ ПРИЗМУ  ИСТОРИИ Его назвали в честь брата отца, который погиб в 19  лет в одном из сражений Великой Отечественной во- йны. Его героический дед прошел четыре войны и умер  от ран в то время, когда Красная Армия громила фа- шистов под Сталинградом. Закономерно, что военная  тема так или иначе неизменно проявляется в его твор- честве. Особенно сегодня… Ведь известный петербургс", char_count: 20000});
