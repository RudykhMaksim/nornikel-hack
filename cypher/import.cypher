CREATE (:Entity:Publication {id: "doc_a5e06c7e34db", name_ru: "CM_10_09.pdf", path: "Журналы/Цветные металлы/2009/CM_10_09.pdf", category: "Журналы", ext: "pdf", size_bytes: 3827641, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "СОДЕРЖАНИЕ   СОДЕРЖАНИЕ  Томского политехнического университета  (Национального исследовательского университета ресурсоэффективных технологий) Московского инженерно физического института (Национального исследовательского ядерного университета) ООО «ИНСТИТУТ ГИПРОНИКЕЛЬ» СанктПетербург Издательский дом «Руда и Металлы». Москва Журнал основан в 1926 г. о к т я б р ь 10•2009 Е Ж Е М Е С Я Ч Н Ы Й ", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_c6f732745d9d", name_ru: "CM_12_09.pdf", path: "Журналы/Цветные металлы/2009/CM_12_09.pdf", category: "Журналы", ext: "pdf", size_bytes: 12216968, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНОТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ ЕЖЕМЕСЯЧНЫЙ НАУЧНОТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 12.2009 12.2009 www.rudmet.ru www.rudmet.ru С Новым  годом! С Новым  годом! ISSN 03722929 ISSN 03722929   Издательский дом «Руда и Металлы». Москва Журнал основан в 1926 г. декабрь 12•2009 Е Ж Е М Е С Я Ч Н Ы Й Н А У Ч Н О  Т Е Х Н И Ч Е С К И Й И П Р О И З В О Д С Т В Е Н Н Ы Й Ж У Р", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_05814a50afc6", name_ru: "CM_01_10.pdf", path: "Журналы/Цветные металлы/2010/CM_01_10.pdf", category: "Журналы", ext: "pdf", size_bytes: 6131403, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "  Томского политехнического  университета (Национального  исследовательского университета  ресурсоэффективных технологий) Московского инженерно- физического института  (Национального исследовательского  ядерного университета) январь 1•2010 Е Ж Е М Е С Я Ч Н Ы Й Н А У Ч Н О . Т Е Х Н И Ч Е С К И Й И П Р О И З В О Д С Т В Е Н Н Ы Й Ж У Р Н А Л РЕДАКЦИОННАЯ КОЛЛЕГИЯ Главный редактор А. В. ПУТИЛОВ  Пе", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_1ee4bf64e99a", name_ru: "CM_02_SP_10.pdf", path: "Журналы/Цветные металлы/2010/CM_02_SP_10.pdf", category: "Журналы", ext: "pdf", size_bytes: 9302340, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Основой лидирующего положения компании Outotec в  качестве поставщика технологий для предприятий добыва- ющей и металлургической отраслей являются долгосроч- ная научно-исследовательская работа и непрерывный по- иск новых идей. В основу развития инновационных техно- логий всегда закладываются требования заказчиков. Наши  решения повышают эффективность и прибыльность произ- водства, а также снижаю", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_228faab901a2", name_ru: "CM_03_10.pdf", path: "Журналы/Цветные металлы/2010/CM_03_10.pdf", category: "Журналы", ext: "pdf", size_bytes: 4686712, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "  Издательский дом «Руда и Металлы». Москва Журнал основан в 1926 г. март 3•2010 Е Ж Е М Е С Я Ч Н Ы Й Н А У Ч Н О  Т Е Х Н И Ч Е С К И Й И П Р О И З В О Д С Т В Е Н Н Ы Й Ж У Р Н А Л УЧРЕДИТЕЛИ: Подписные индексы: 71060 (Роспечать) 83869 (ОК «Пресса России») Московский государственный  институт стали и сплавов (Национальный исследовательский технологический университет) Государственного  Эрмитаж", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_23a6cb5c3675", name_ru: "CM_04_10.pdf", path: "Журналы/Цветные металлы/2010/CM_04_10.pdf", category: "Журналы", ext: "pdf", size_bytes: 5905998, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Дорогие друзья! Примите поздравления по случаю 65-летнего юбилея Центра наук о Земле,  металлургии и обогащения (ранее Институт металлургии и обогащения). Ваш Центр — ведущая научно-исследовательская организация Республики  Казахстан, имеющая глубокие научные традиции, крупные результаты в области  теории металлургических процессов и разработки эффективных технологий  переработки металлсодержащег", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_43e0e79fedf7", name_ru: "CM_05_10.pdf", path: "Журналы/Цветные металлы/2010/CM_05_10.pdf", category: "Журналы", ext: "pdf", size_bytes: 5724701, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "  Е Ж Е М Е С Я Ч Н Ы Й Н А У Ч Н О  Т Е Х Н И Ч Е С К И Й И П Р О И З В О Д С Т В Е Н Н Ы Й Ж У Р Н А Л Издательский дом «Руда и Металлы». Москва Журнал основан в 1926 г. май 5•2010 УЧРЕДИТЕЛИ: Подписные индексы: 71060 (Роспечать) 83869 (ОК «Пресса России») Московский государственный  институт стали и сплавов (Национальный исследовательский технологический университет) Государственного  Эрмитажа", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_5b73a198addb", name_ru: "CM_06_10.pdf", path: "Журналы/Цветные металлы/2010/CM_06_10.pdf", category: "Журналы", ext: "pdf", size_bytes: 6783802, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Уважаемые коллеги,  руководители и специалисты,  читатели журнала! Для каждого из нас третье воскре- сенье июля — не просто большое со- бытие в праздничном календаре. День  металлурга — наш главный праздник, в  нем отражена вся неповторимая судьба  Норильского комбината. В этом году, в  канун 75-летнего юбилея предприятия,  это и хороший повод еще раз всесто- ронне проанализировать наши дости- же", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_c1e3a0ad57ec", name_ru: "CM_07_10.pdf", path: "Журналы/Цветные металлы/2010/CM_07_10.pdf", category: "Журналы", ext: "pdf", size_bytes: 4371052, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "  Способ получения микрокристалличес кого порошка иттрия Влияние  добавок углеродных нано трубок на свойства  силицированных  графитов Всероссийская молодежная школаконференция «Современные  проблемы  металловедения»,  2009 В номере: ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ  И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ  И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ www.rudmet.ru ISSN 0372-2929 ISSN 0372-2929 www", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_a9693bf4ab9c", name_ru: "CM_08_10.pdf", path: "Журналы/Цветные металлы/2010/CM_08_10.pdf", category: "Журналы", ext: "pdf", size_bytes: 10990094, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "В номере: ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ  И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ  И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ www.rudmet.ru ISSN 0372-2929 ISSN 0372-2929 www.rudmet.ru 8.2010 8.2010 НТУ «Харьковский политехнический институт» — 125 лет Алюминиевые  сплавы в самолетостроении Проблемы информационной безопасности и пути ее обеспечения   Е Ж Е М Е С Я Ч Н Ы Й Н А У Ч Н О  Т Е Х Н И Ч Е", char_count: 20000});
