CREATE (:Entity:Publication {id: "doc_b810f727c627", name_ru: "CM_05_12.pdf", path: "Журналы/Цветные металлы/2012/CM_05_12.pdf", category: "Журналы", ext: "pdf", size_bytes: 4289208, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНОТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ www.rudmet.ru ISSN 03722929   Е Ж Е М Е С Я Ч Н Ы Й Н А У Ч Н О  Т Е Х Н И Ч Е С К И Й И П Р О И З В О Д С Т В Е Н Н Ы Й Ж У Р Н А Л 5•2012 Подписные индексы: 71060 (Роспечать) 83869 (ОК «Пресса России») май Издательский дом «Руда и Металлы». Москва Журнал основан в 1926 г. УЧРЕДИТЕЛИ: Национальный исследовательский технологический универс", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_a3ae030ee15a", name_ru: "CM_06_12.pdf", path: "Журналы/Цветные металлы/2012/CM_06_12.pdf", category: "Журналы", ext: "pdf", size_bytes: 4482899, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "  Е Ж Е М Е С Я Ч Н Ы Й Н А У Ч Н О  Т Е Х Н И Ч Е С К И Й И П Р О И З В О Д С Т В Е Н Н Ы Й Ж У Р Н А Л 6•2012 Подписные индексы: 71060 (Роспечать) 83869 (ОК «Пресса России») июнь Издательский дом «Руда и Металлы». Москва Журнал основан в 1926 г. УЧРЕДИТЕЛИ: Национальный исследовательский технологический университет «МИСиС» Государственного  Эрмитажа © «Цветные металлы», 2012 ООО «ИНСТИТУТ ГИПРО", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_b7b0e126aa45", name_ru: "CM_07_12.pdf", path: "Журналы/Цветные металлы/2012/CM_07_12.pdf", category: "Журналы", ext: "pdf", size_bytes: 6237314, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " УВАЖАЕМЫЕ ЧИТАТЕЛИ! От всей души поздравляю вас с Днем металлурга! Добыча полезных ископаемых и выплавка метал- лов издавна составляли основу промышленного раз- вития человеческого общества. Черная и цветная  металлургия  и поныне относятся к базовым отраслям  народного хозяйства, активно влияющим на работу практически  всех сфер нашей деятельности. Я родился и вырос в металлургическом Златоусте,", char_count: 20000});
