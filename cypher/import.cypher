CREATE (:Entity:Publication {id: "doc_c8d564532efd", name_ru: "CM_12_13.pdf", path: "Журналы/Цветные металлы/2013/CM_12_13.pdf", category: "Журналы", ext: "pdf", size_bytes: 6085824, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "Уральское отделение РАН: фундаментальная наука — современному производству ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 12. 2013  Уважаемые читатели! П редставленный вашему вниманию номер журнала  «Цветные металлы» включает небольшую часть иссле- дований институтов Уральского отделения РАН, направлен- ных на решение актуальных задач металлургического ком- плекса РФ. Начиная с момента з", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_ce0de979f8d7", name_ru: "CM_01_14.pdf", path: "Журналы/Цветные металлы/2014/CM_01_14.pdf", category: "Журналы", ext: "pdf", size_bytes: 3041180, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "В номере: •  Удаление радиоактивных примесей из вторичной платины •  Технико-экономические особенности производства магния в России •  Переработка упорных золотосодержащих сульфидных концентратов автоклавным окислением •  Сварка трением с перемешиванием в производстве крупногабаритных изделий из алюминиевых сплавов •  Алюминиевые сплавы системы Al – Mg – Sc для сварных и паяных конструкций ЕЖЕМЕСЯ", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_56e07b82fe07", name_ru: "CM_02_14 (2).pdf", path: "Журналы/Цветные металлы/2014/CM_02_14 (2).pdf", category: "Журналы", ext: "pdf", size_bytes: 3006182, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "В номере: •  Интервью с Д. Л. Зверевым, генеральным директором —                генеральным конструктором ОАО «ОКБМ Африкантов» •  Методы совершенствования прогнозирования развития                энергоснабжения месторождений полезных ископаемых •  Пирометаллургическая технология получения германиевых концентратов •  Электрофизические свойства композитов Cu — Nb ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПР", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_ffbc80ab91de", name_ru: "CM_03_14.pdf", path: "Журналы/Цветные металлы/2014/CM_03_14.pdf", category: "Журналы", ext: "pdf", size_bytes: 3113842, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 3. 2014 В номере: •  Оценка рыночной стоимости технологии производства нанокомпозита FeCo/C •  Перспективы применения автоклавной технологии на Олимпиадинском                горно-обогатительном комбинате •  Извлечение галлия из щелочных растворов глиноземного производства •  Диффузионно-твердеющие припои на основе меди и галлия •  К XXII зи", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_dec0cd85539d", name_ru: "CM_04_14.pdf", path: "Журналы/Цветные металлы/2014/CM_04_14.pdf", category: "Журналы", ext: "pdf", size_bytes: 5298935, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "СанктПетербургскому СанктПетербургскому государственному государственному политехническому университету политехническому университету 115 лет 115 лет ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ 4. 2014   Е Ж Е М Е С Я Ч Н Ы Й Н А У Ч Н О  Т Е Х Н И Ч Е С К И Й И П Р О И З В О Д С Т В Е Н Н Ы Й Ж У Р Н А Л Подписные индексы: 71060 (Роспечать) 83869 (ОК «Пресса России») апрель Журнал", char_count: 20000});
