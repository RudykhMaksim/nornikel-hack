CREATE (:Entity:Publication {id: "doc_81abb69c9581", name_ru: "ЦМ №6-2018.pdf", path: "Журналы/Цветные металлы/2018-все/ЦМ №6-2018.pdf", category: "Журналы", ext: "pdf", size_bytes: 3205018, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "Центру инженерного сопровождения  производства Заполярного филиала  ГМК «Норильский никель»   Сердечно поздравляю трудовой коллектив Центра инже- нерного сопровождения производства Заполярного филиала  компании «Норильский никель» с 80-летием. Центр был основан в 1938 г. для отработки новых техниче- ских решений и сопровождения действующего производ- ства. На протяжении всех лет своего существован", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_3a495dc6bbc4", name_ru: "ЦМ №8 - 2018.pdf", path: "Журналы/Цветные металлы/2018-все/ЦМ №8 - 2018.pdf", category: "Журналы", ext: "pdf", size_bytes: 6210392, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Уважаемые коллеги и читатели журнала! Этот номер конца лета особенный. Он выходит накануне  очень важного и знакового для всего горно-метал лур- гического сообщества события — проведения в России,  в нашей столице, Международного конгресса по обогаще- нию полезных ископаемых (IMPC – 2018). Значение такого  форума для горняков и металлургов очень велико — по сути  это можно сравнить только с проше", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_c0e69593051a", name_ru: "ЦМ № 1-2019.pdf", path: "Журналы/Цветные металлы/2019/ЦМ № 1-2019.pdf", category: "Журналы", ext: "pdf", size_bytes: 2965307, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru ISSN 0372-2929 ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 913)  1. 2019  Поздравляю Вас с наступившим Новым годом! Пусть 2019 г.  станет для Вас, Ваших родных и близких, друзей и товарищей,  детей, внуков и правнуков годом радости и исполнения желаний,  годом творческих и трудовых успехов. Здоровья Вам и удачи! Продолжая рубрику колонки главного ре", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_a541bed6c990", name_ru: "ЦМ № 10-2019.pdf", path: "Журналы/Цветные металлы/2019/ЦМ № 10-2019.pdf", category: "Журналы", ext: "pdf", size_bytes: 5501148, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "150 лет Периодической системе  химических элементов  Д. И. Менделеева  V Vanadium Ванадий 23 50,941 Ag Argentum Серебро 47 107,868 Cd Cadmium Кадмий 48 112,41 Sr Strontium Стронций 38 87,62 Zr Zirconium Цирконий 40 91,22 In Indium Индий 49 114,82 Sb Stibium Сурьма 51 121,75 As Arsenicum Мышьяк 33 74,992  Уважаемые читатели! В 2019 году исполняется 150 лет со дня открытия Периодического зако- на хи", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_25ededa5a5e9", name_ru: "ЦМ № 11-2019.pdf", path: "Журналы/Цветные металлы/2019/ЦМ № 11-2019.pdf", category: "Журналы", ext: "pdf", size_bytes: 5181898, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "РЕКЛАМА  Этот выпуск журнала «Цветные металлы» целиком посвя- щен АО «Кольская ГМК». Мне, как главе Мурманской обла- сти, чрезвычайно приятно внимание, уделенное изданием  одному из крупнейших промышленных предприятий нашего  региона, главных «локомотивов» экономики Кольского  Заполярья. Говоря о КГМК, начать стоит с ключевой роли предприя- тия в истории освоения Кольского Севера. Как известно,  М", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_2aca6204c659", name_ru: "ЦМ № 12-2019.pdf", path: "Журналы/Цветные металлы/2019/ЦМ № 12-2019.pdf", category: "Журналы", ext: "pdf", size_bytes: 3224828, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 924)  12. 2019 ISSN 0372-2929 www.rudmet.ru ISSN 0372-2929 д (№ 924) ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г.  Перед вами завершающий 2019 год декабрьский номер  журнала «Цветные металлы». Весь прошедший год журнал  продолжал выполнение миссии по информированию практи- че", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_a4f3fe9cb91d", name_ru: "ЦМ № 2-2019.pdf", path: "Журналы/Цветные металлы/2019/ЦМ № 2-2019.pdf", category: "Журналы", ext: "pdf", size_bytes: 3688664, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru ISSN 0372-2929 ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 914)  2. 2019  В журнале «Цветные металлы» затрагивается широкий  спектр технологических, технических проблем производства  цветных металлов — от стадии получения минеральных кон- центратов цветных металлов до готовой продукции в виде  сплавов и изделий различного функционального назначения;", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_552b5019e6be", name_ru: "ЦМ № 3-2019.pdf", path: "Журналы/Цветные металлы/2019/ЦМ № 3-2019.pdf", category: "Журналы", ext: "pdf", size_bytes: 3548356, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 915)  3. 2019 ISSN 0372-2929  Цветные металлы остаются важнейшими материалами, исполь- зуемыми в различных отраслях промышленности. Их мировое про- изводство в основном неуклонно растет. В журнале «Цветные  металлы» регулярно публикуются очень интересные материалы  о выпуске цветных металлов, их стоимости ", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_2051ec1d1abb", name_ru: "ЦМ № 4-2019.pdf", path: "Журналы/Цветные металлы/2019/ЦМ № 4-2019.pdf", category: "Журналы", ext: "pdf", size_bytes: 5586491, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru ISSN 0372-2929 ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 916)  4. 2019  Открывая данный номер, хотел бы еще раз напомнить, что на  титуле журнала есть надпись, что он является официальным инфор- мационным органом Федерального учебно-методического объеди- нения (ФУМО) «Технологии и материалы», и журнал как никакой дру- гой подходит к этим требовани", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_0964219f9716", name_ru: "ЦМ № 5-2019.pdf", path: "Журналы/Цветные металлы/2019/ЦМ № 5-2019.pdf", category: "Журналы", ext: "pdf", size_bytes: 4490100, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "5. 2019 www.rudmet.ru ISSN 0372-2929 ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 917)  C Днем Победы! C Днем Победы!  Цветные металлы и сплавы на их основе широ- ко применяют при изготовлении изделий общего  и специального машиностроения. Наиболее  широко они востребованы при производстве  деталей и узлов ракетно-космической техники.  В связи со спецификой примен", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_0faeb1e0cb02", name_ru: "ЦМ № 6-2019.pdf", path: "Журналы/Цветные металлы/2019/ЦМ № 6-2019.pdf", category: "Журналы", ext: "pdf", size_bytes: 4703621, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "6. 2019 www.rudmet.ru ISSN 0372-2929 ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 918)  Научнотехнические разработки ВНИИХТ (с. 39)  УВАЖАЕМЫЕ ЧИТАТЕЛИ! Открывая июньский номер журнала «Цветные металлы»,  хотел бы обратить внимание читателей на появление новой  рубрики — «Научно-технические разработки ВНИИХТ». Акционерное общество «Ведущий научно-иссле дова- тель", char_count: 20000});
