CREATE (:Entity:Publication {id: "doc_ad55bcde50e1", name_ru: "GoldQ42006.pdf", path: "Материалы конференций/Источники данных о МПГ/Квартальные издания/CRU/2006/GoldQ42006.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 277589, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Precious Metals Quarterly 4Q2006     Gold   CRU International Limited confidential  Gold    Recent trends  Prices remained below $600 for the second half of September and for much of October.  Right  at the end of October, the weakening in the US dollar and fears over a US economic slowdown,  prompted by slower than expected US growth in Q3, caused the gold price to rise again.  It  remained in ", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_867300e80658", name_ru: "SilverQ42006.pdf", path: "Материалы конференций/Источники данных о МПГ/Квартальные издания/CRU/2006/SilverQ42006.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 254621, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Precious Metals Quarterly 4Q2006     Silver   CRU International Limited confidential      Silver    Recent trends  At $11.55/oz, silver successfully challenged its 1987 peak in 2006 and averaged its highest level  since 1984 in real terms ($14.08/oz).  The fourth quarter of 2006 has also been a record in its  own right (and not only when compared with the second quarter of that year), it too bre", char_count: 20000});
