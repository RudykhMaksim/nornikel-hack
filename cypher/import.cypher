CREATE (:Entity:Publication {id: "doc_8b36260f2a68", name_ru: "CopperMonitor2011Oct.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2011/CopperMonitor2011Oct.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 353685, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "October 2011        © 2011 CRU International Limited confidential  Mind the scrap   Scrap availability has tightened as merchants hold back material for which they paid  more than they can receive if they sell it, which will support cathode demand.  This  will become more acute China, as scrap on the water arrives and is held.   Strikes continue to plague the miners, as do disruptions from ore g", char_count: 20000});
