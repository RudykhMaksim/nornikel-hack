CREATE (:Entity:Publication {id: "doc_983f952b2574", name_ru: "CRU-Cu-2Q09_Summary_24apr2009.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-2Q09_Summary_24apr2009.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 320991, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "Copper Quarterly Report April 2009  CRU International Limited confidential  Executive Summary  Diversion from reality  CRU estimates that global demand slumped by 18% year-on-year in Q1 2009, a clear indicator  that we are in the middle of the worst economic crisis since the early 1970s.  Despite the  collapse in demand, production declined by only 4.5% resulting in a market surplus in the  quarte", char_count: 20000});
