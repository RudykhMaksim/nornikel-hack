CREATE (:Entity:Publication {id: "doc_3747f61c4504", name_ru: "CM_08_09.pdf", path: "Журналы/Цветные металлы/2009/CM_08_09.pdf", category: "Журналы", ext: "pdf", size_bytes: 2970386, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ www.rudmet.ru ISSN 0372–2929 www.rudmet.ru 8.2009 Выпуск посвящен решению проблем повышения комплексности  и эффективности использования природных ресурсов  в Заполярном филиале ОАО «ГМК «Норильский никель» Выпуск посвящен решению проблем повышения комплексности  и эффективности использования природных ресурсов  в Заполярном филиале ОАО «ГМК", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_1c7dd643de6c", name_ru: "CM_09_09.pdf", path: "Журналы/Цветные металлы/2009/CM_09_09.pdf", category: "Журналы", ext: "pdf", size_bytes: 3964031, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ www.rudmet.ru ISSN 0372–2929 www.rudmet.ru 9.2009 9.2009 Содержание  Коллективу института «Гипроникель» Дорогие друзья! Примите поздравления по случаю 75летнего юбилея Института.  Ваш институт объединяет в себе ведущую отечественную на учноисследовательскую школу в области цветной металлургии и один из лучших в стране проектных коллективо", char_count: 20000});
