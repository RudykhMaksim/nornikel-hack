CREATE (:Entity:Publication {id: "doc_74dad48c5495", name_ru: "CRU-Cu-ChinaFortnightly-2009Aug28.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-ChinaFortnightly-2009Aug28.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 177581, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "August 2009          © 2009 CRU International Limited confidential  17th – 28th August 2009  SHFE prices trade in a wide range  SHFE prices have fluctuated significantly since the  last report, the daily official cash month price  falling from RMB 50,000/t on 14th August to RMB  46,730/t by 19th August then rose to a new annual  high of RMB 50,300/t on 26th August.  SHFE prices  have followed the ", char_count: 7002});
CREATE (:Entity:Publication {id: "doc_fc8d8eb2c45d", name_ru: "CRU-Cu-ChinaFortnightly-2009Sep25.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-ChinaFortnightly-2009Sep25.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 128384, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "September 2009          © 2009 CRU International Limited confidential  14th – 25th September 2009  SHFE copper inventory rises to five year high  SHFE copper stocks rose to a five year high of 104,248t on 18th September, a level not reached since  April 2004.  There are several reasons for the inventory jump.  Firstly, copper scrap availability has eased.   As the discount for scrap has widened, c", char_count: 7647});
CREATE (:Entity:Publication {id: "doc_87ca1a6d413a", name_ru: "CRU-Cu-ChinaFortnightly2009Dec18.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-ChinaFortnightly2009Dec18.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 114686, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "December 2009          © 2009 CRU International Limited confidential    7th December - 18th December 2009  Spot premium for import cathode rallied  The spot premium for import cathode has experienced a rally, mainly attributed to two reasons.  Firstly,  the annual contract premium for 2010 is $85/t, and therefore the spot premium quotation may rise towards  that level.  Secondly, the SHFE/LME rati", char_count: 6915});
CREATE (:Entity:Publication {id: "doc_5b6583072b43", name_ru: "CRU-Cu-ChinaFortnightly2009Dec31.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-ChinaFortnightly2009Dec31.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 114717, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "December 2009          © 2009 CRU International Limited confidential    21st December-31st December 2009    TC/RCs annual negotiations still continue  Major Japanese smelters have accepted a 38% reduction (compared to the 2009 annual terms of  $75/7.5¢/lb) in 2010 processing fees with Freeport McMoRan, setting a benchmark for the TC/RCs  annual negotiations.  TC/RCs were settled at $46.5/4.65¢/lb.", char_count: 7064});
CREATE (:Entity:Publication {id: "doc_d95c3ba8ace7", name_ru: "CRU-Cu-ChinaFortnightly2009Nov06.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-ChinaFortnightly2009Nov06.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 116360, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "November 2009          © 2009 CRU International Limited confidential  26th October 2009 – 6th November 2009  SHFE stocks hit five-year high; LME Asia stocks continue to rise  SHFE copper stocks rose 6,859t in the week ending 30th October, and a further 1,440t in the week ending  6th November.  This took SHFE stocks to a fresh five-year high.  Total stocks are now 104,275t.   However, this second r", char_count: 7515});
CREATE (:Entity:Publication {id: "doc_14c12a7d4790", name_ru: "CRU-Cu-ChinaFortnightly2009Nov23.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-ChinaFortnightly2009Nov23.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 108014, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "November 2009          © 2009 CRU International Limited confidential  9th - 20th November 2009  Codelco settles 2010 premium for China at $85/t  Codelco has settled its copper premium for delivery to China at $85/t for the 2010 annual contract.  The  premium is at the higher end of market expectations, which were around $80-$85/t.  Against a  background of a negative SHFE-LME arbitrage and a coppe", char_count: 7397});
CREATE (:Entity:Publication {id: "doc_31e7effc41f4", name_ru: "CRU-Cu-mill-monit-12aug09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-mill-monit-12aug09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 328902, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "August 2009    Page 1 of 12  © 2009 CRU International Limited confidential  www.crumonitor.com    Cautious talk on “recovery” prospects    Following a 26.7% slump in world consumption in Q1 2009 to 1.8mt, our preliminary  assessment of global demand in Q2 is a 20.4% y-o-y decline to 2.0mt.  Although it is  encouraging that this does show a sequential quarterly improvement of 8.8% it is far  too e", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_0caf39fa29f9", name_ru: "CRU-Cu-mill-monit-15apr09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-mill-monit-15apr09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 398709, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "April 2009    Page 1 of 12  © 2009 CRU International Limited confidential  www.crumonitor.com    Into the depths of recession…   Preliminary data for the first quarter of 2009 indicates that global demand for copper  and copper alloy mill products fell for the fourth successive quarter on a year-on- year basis, and for the third successive quarter on a sequential basis.  The speed of  decline acc", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_0010a65d4c4f", name_ru: "CRU-Cu-mill-monit-15dec09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-mill-monit-15dec09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 418179, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "December 2009    Page 1 of 12  © 2009 CRU International Limited confidential  www.crumonitor.com    US chases Asian recovery     Our preliminary data shows that the world’s copper and alloy semis output in Q3  was still 18% below year-ago levels, with alloy rod, bar and section suffering the  most severe y-o-y decline in volumes.  North East and Developing Asia is  undergoing a more rapid recover", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_eb8c813c2dd4", name_ru: "CRU-Cu-mill-monit-21oct09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-mill-monit-21oct09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 325851, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "October 2009    Page 1 of 12  © 2009 CRU International Limited confidential  www.crumonitor.com    Growth in Asian output y-o-y but not elsewhere yet     The biggest story has to be the anti-dumping petition signed by Cerro Flow,  KobeWieland and Mueller against Chinese and Mexican seamless copper tube  fabricators. From an independent point of view, the exporters have indeed seized  some market ", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_7d48c0eba2ab", name_ru: "CRU-Cu-monit-1apr09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-monit-1apr09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 281569, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "April 2009        © 2009 CRU International Limited confidential  Wave of optimism upon a sea of despair   Copper prices broke through the $4,000/t barrier in March, as the market reacted to  record Chinese imports and falling LME stocks.  Chinese imports have been boosted  by a tight scrap market and stockbuilding by the State Reserve Bureau (SRB).   Demand, though, remains terrible.  CRU is now", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_4e7a7ed78cc1", name_ru: "CRU-Cu-monit-1aug09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-monit-1aug09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 306545, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "August 2009        © 2009 CRU International Limited confidential  Red hot summer   Copper prices have had a blistering summer, averaging more than $5,100/t in July.   Optimism about China and a renewed appetite for risk from investors have been  driving the rise.  However, prices are looking increasingly out of touch with  fundamentals.  CRU believes that a correction is likely.   Chinese demand", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_3569ed9909aa", name_ru: "CRU-Cu-monit-1dec09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-monit-1dec09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 318491, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "December 2009        © 2009 CRU International Limited confidential  Sentimental market   Refined production will continue to improve to take advantage of prices well above the  costs of most mines, as there have been few supply disruptions and the Spence strike  is now over.   Chinese imports and apparent consumption continue to decline from the June highs,  showing the market is oversupplied.  ", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_75ccf037f6b5", name_ru: "CRU-Cu-monit-1jul09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-monit-1jul09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 296139, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "July 2009        © 2009 CRU International Limited confidential  Double trouble   The acute phase of the financial crisis appears to be over.  Improved economic  sentiment has pushed LME prices to a new annual high over the past month, despite  SHFE prices having fallen from their early April highs.   There has been little to report on the mine side, as prices above $4,500/t mean that  there is n", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_736882add305", name_ru: "CRU-Cu-monit-1jun09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-monit-1jun09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 357346, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "June 2009        © 2009 CRU International Limited confidential  Full to bursting?   The Chinese buying wave is coming to an end, with the domestic market having  moved into oversupply over the past month.  The question now is how much excess  material China has agreed to take and how long it will take to work through the  inventory.  The bottom may have been reached in consumption outside of Chin", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_6ff081ac13f9", name_ru: "CRU-Cu-monit-1oct09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-monit-1oct09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 361335, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "October 2009        © 2009 CRU International Limited confidential  A pause or a turning point   Rising exchange stocks, falling premiums and disappointing post-summer demand  are all signs that indicate a possible turning point in the physical copper market.   But Exchange markets are not convinced, and prices have recovered in the past few  days, supported by the weaker dollar and positive macr", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_43ac6a9ba651", name_ru: "CRU-Cu-monit-1sep09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-monit-1sep09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 297152, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "September 2009        © 2009 CRU International Limited confidential  Chinese consumption – Real or apparent?   Chinese copper demand remains robust, but issues over the accuracy of Chinese  copper data make answering the question in the title difficult.  With some sectors  outperforming expectations, we have raised our estimate for full year Chinese  growth to 14%.  Demand elsewhere appears to be", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_1db0e58545fc", name_ru: "CRU-Cu-monit-2nov09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-monit-2nov09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 321555, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "November 2009        © 2009 CRU International Limited confidential  Betting on China   Chinese imports kept the market ex-China in deficit in Q2 and Q3.  However, the  SHFE-LME arbitrage has been closed for several months and we expect Chinese  imports to fall from the surprisingly strong September figure.   The market ex-China should, given lower Chinese imports and continued q-o-q  increases i", char_count: 20000});
