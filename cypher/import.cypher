CREATE (:Entity:Publication {id: "doc_68562cfb8f6d", name_ru: "ИС-4-2017 Краткий обзор медно-никелевых обогатительных фабрик.pdf", path: "Обзоры/ИС-4-2017 Краткий обзор медно-никелевых обогатительных фабрик.pdf", category: "Обзоры", ext: "pdf", size_bytes: 2250324, sensitivity: "internal", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Список исполнителей      Специалист 1 кат.  Подоханова С.В.         3     2017 г  Краткий обзор медно-никелевых обогатительных фабрик  ООО «Институт Гипроникель»  Для выявления примеров эффективного применения рудного сгущения,  непосредственно перед стадией флотации, были рассмотрены технологические  схемы 13 зарубежных предприятий, перерабатывающих никелевые руды,  технологические  цепочки  3-х", char_count: 7256});
CREATE (:Entity:Publication {id: "doc_8e9c76887662", name_ru: "Использование хвостов обогащения в качестве составляющих закладочных смесей.docx", path: "Обзоры/Использование хвостов обогащения в качестве составляющих закладочных смесей.docx", category: "Обзоры", ext: "docx", size_bytes: 14778, sensitivity: "internal", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "Использование хвостов обогащения в качестве составляющих закладочных смесей старая, давно устоявшиеся технология. В СССР хвосты обогащения применялись в качестве составляющей смеси с 50-х годов 20 века. Промышленное освоение такой закладки осуществлено на Пышминском руднике [1] в начале 50-х годов по разработкам Унипроммеди (Н.П. Влох и П.И. Коулпаев). С 1961 года по разработкам ученых ИГДАН КазСС", char_count: 2216});
