CREATE (:Entity:Publication {id: "doc_c38ccf3b7eb9", name_ru: "6 Влияние различных факторов на окисление железа, часть 2 v3.docx", path: "Статьи/6 Влияние различных факторов на окисление железа, часть 2 v3.docx", category: "Статьи", ext: "docx", size_bytes: 533634, sensitivity: "internal", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "Клименко И.В. – Абрамова У.В. – Грейвер М.Б. – Платонов И.С. Влияние различных факторов на окисление железа в высококонцентрированных хлоридных никелевых растворах. Часть 2 Введение В первой части работы [1] было исследовано влияние ряда факторов, влияющих на окисление железа в высококонцентрированных хлоридных никелевых растворах: интенсивности перемешивания раствора при непрерывной подаче окисли", char_count: 19298});
