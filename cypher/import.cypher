CREATE (:Entity:Publication {id: "doc_aec80629da52", name_ru: "ЦМ № 9-2019.pdf", path: "Журналы/Цветные металлы/2019/ЦМ № 9-2019.pdf", category: "Журналы", ext: "pdf", size_bytes: 3144667, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru www.rudmet.ru ISSN 0372-2929 ISSN 0372-2929 ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 921)  Издается с 1926 г. (№ 921)  9. 2019 9. 2019 6060 ИНСТИТУТУ ЦВЕТНЫХ МЕТАЛЛОВ И МАТЕРИАЛОВЕДЕНИЯ ИНСТИТУТУ ЦВЕТНЫХ МЕТАЛЛОВ И МАТЕРИАЛОВЕДЕНИЯ И И ЛЕТ ЛЕТ Реклама  Уважаемые читатели! В текущем году исп", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_d1a01d81bc79", name_ru: "ЦМ № 1-2020.pdf", path: "Журналы/Цветные металлы/2020/ЦМ № 1-2020.pdf", category: "Журналы", ext: "pdf", size_bytes: 4574968, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 925)  1. 2020 ISSN 0372-2929 www.rudmet.ru  Наступление Нового года это не только смена дат  в календаре — это пора добрых надежд и ожиданий,  время, когда мы подводим итоги, строим планы на  будущее. Дружной команде Кольской ГМК 2019 год запом- нится важными событиями, которые дали нам уни- кальный опыт, научили справл", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_aff7d382f679", name_ru: "ЦМ № 10-2020.pdf", path: "Журналы/Цветные металлы/2020/ЦМ № 10-2020.pdf", category: "Журналы", ext: "pdf", size_bytes: 3643920, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "К 250ЛЕТИЮ САНКТПЕТЕРБУРГСКОГО  ГОРНОГО УНИВЕРСИТЕТА К 250ЛЕТИЮ САНКТПЕТЕРБУРГСКОГО  ГОРНОГО УНИВЕРСИТЕТА ISSN 0372-2929 ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 934)  www.rudmet.ru 10. 2020  Горно-металлургическая промышленность занимает особое  место в развитии любого государства, вносит значительный вклад  в получение валового внутреннего продукта, обес", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_92919538d438", name_ru: "ЦМ № 11-2020.pdf", path: "Журналы/Цветные металлы/2020/ЦМ № 11-2020.pdf", category: "Журналы", ext: "pdf", size_bytes: 3773726, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ISSN 0372-2929 ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 935)  www.rudmet.ru 11. 2020 60 лет Самарскому металлургическому заводу  Самарскому металлургическому заводу  60 лет (с. 70)  В этом номере представлены научные статьи  сотрудников Самарского металлургического завода:  признанных профессионалов, посвятивших десятки  лет родному предприятию, и молодого пок", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_67eae56cc2c0", name_ru: "ЦМ № 12 -2020.pdf", path: "Журналы/Цветные металлы/2020/ЦМ № 12 -2020.pdf", category: "Журналы", ext: "pdf", size_bytes: 4750803, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Уважаемые коллеги! Этот номер журнала целиком посвящен интеллектуально- му  потенциалу ПАО «ГМК «Норильский никель» (далее Компа- ния) — институту «Гипроникель». В составе Компании институт уже 30 лет и выполняет основной объем научно-исследовательских  и проектных работ, необходимых для совершенствования и раз- вития наших предприятий. Специализация института соответствует профилю техноло- гичес", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_f07afdc6b155", name_ru: "ЦМ № 2-2020.pdf", path: "Журналы/Цветные металлы/2020/ЦМ № 2-2020.pdf", category: "Журналы", ext: "pdf", size_bytes: 5226430, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 926)  2. 2020 ISSN 0372-2929 www.rudmet.ru Научнотехнические разработки Навоийского ГМК (с. 5)  В своей работе все вы постоянно решаете задачи, связанные с повышением эффектив- ности производства, — улучшением качества и уменьшением себестоимости продукции,  утилизацией отходов, охраной окружающей среды и т. д. Я хочу ", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_27524f6c7c7b", name_ru: "ЦМ № 3 -2020.pdf", path: "Журналы/Цветные металлы/2020/ЦМ № 3 -2020.pdf", category: "Журналы", ext: "pdf", size_bytes: 5222271, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Уважаемые читатели! В конце 2019 г. вышел в свет специальный номер журнала «Цветные металлы», посвященный деятельности, промышленным успехам и разра- боткам АО «Кольская горно-металлургическая компания». Когда специали- сты компании начали подготовку к выходу данного номера, было опасение не набрать необходимого количества материалов, однако ближе к моменту публикации мы поняли, что статей написа", char_count: 20000});
