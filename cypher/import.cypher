CREATE (:Entity:Publication {id: "doc_360ceea13e4d", name_ru: "CopperChinaFortnightly2012Aug31.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2012/CRU-China reports/CopperChinaFortnightly2012Aug31.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 164435, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "August 2012            © 2012 CRU International Limited confidential                    20th August – 31st August  Domestic supply on the rise  CNIA reported that China produced 142,492 tonnes of copper-in-concentrate in July. Year-to-date output  totalled 875,975 tonnes, representing an increase of 12.3% compared to the first seven months of 2011.   Recently, two large mines have come on-stream. ", char_count: 6958});
