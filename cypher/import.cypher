CREATE (:Entity:Publication {id: "doc_1f8dc5ba56b4", name_ru: "Silver.pdf", path: "Материалы конференций/Источники данных о МПГ/Квартальные издания/CRU/2007/Mar 2007/PreciousMetaslQuarterly2007MarReport.zip::Silver.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 242632, sensitivity: "public", confidence: "verified", deep_parsed: false, geography: "International"});
CREATE (:Entity:Publication {id: "doc_687242e93d6b", name_ru: "Executive Summary.pdf", path: "Материалы конференций/Источники данных о МПГ/Квартальные издания/CRU/2007/Quaterly/Executive Summary.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 165059, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Precious Metals Quarterly 1Q2007  CRU International Limited confidential  Executive summary    Rally resumed  After a shaky start to 2007, precious metals’ prices moved steadily higher during the first  quarter.  Though the sector succumbed to the weak sentiment that swept through the global  equity and commodity markets in early March, platinum and palladium have more than  recovered their loss", char_count: 15571});
CREATE (:Entity:Publication {id: "doc_0c42721f2022", name_ru: "GoldQ12007.pdf", path: "Материалы конференций/Источники данных о МПГ/Квартальные издания/CRU/2007/Quaterly/GoldQ12007.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 307949, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Precious Metals Quarterly 1Q2007     Gold   CRU International Limited confidential  Gold    Recent trends  The gold price rose fairly steadily from 10 January ($608.40/oz at the pm fix) to 26 February  ($685.75/oz).  However while the first part of this rise appeared to be well supported by  physical demand, the second stage appeared to be driven largely by speculative interest.  Accordingly the", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_20cc8f4d33db", name_ru: "PalladiumQ12007.pdf", path: "Материалы конференций/Источники данных о МПГ/Квартальные издания/CRU/2007/Quaterly/PalladiumQ12007.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 275887, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Precious Metals Quarterly 1Q2007      Palladium   CRU International Limited confidential  Palladium    Recent trends  Palladium broke out of its trading range in a technically significant manner at the end of 2006,  finally reaching $340/oz and then $350/oz by the end of January on the back of fresh fund  buying and strong gains in platinum.  Like its sister metal, palladium too succumbed to the", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_63719307c02e", name_ru: "PlatinumQ12007.pdf", path: "Материалы конференций/Источники данных о МПГ/Квартальные издания/CRU/2007/Quaterly/PlatinumQ12007.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 343309, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Precious Metals Quarterly 1Q2007      Platinum   CRU International Limited confidential  Platinum    Recent trends  Platinum maintained a gentle up-trend from mid-December through to early March, primarily in  response to supply-side news.  A sell-off in the global equity and commodities markets saw  platinum fall by almost 7% to a low of $1,165/oz on 5 March, but the correction was short- lived", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_3e8bafcbc277", name_ru: "Silver.pdf", path: "Материалы конференций/Источники данных о МПГ/Квартальные издания/CRU/2007/Quaterly/Silver.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 242632, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Precious Metals Quarterly 1Q2007     Silver   CRU International Limited confidential      Silver    Recent trends:  high prices weakening outlook  It has not broken any fresh new highs, the highest London fix in the first quarter of this year  being $14.58/oz (on 26th February) compared with $14.94/oz in May last year.  However, the  London fix never fell below $12.21/oz in January-March, a feat", char_count: 20000});
