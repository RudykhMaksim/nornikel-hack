CREATE (:Entity:Publication {id: "doc_b6b0d107cd36", name_ru: "CRU-Cu-China-2010Mar26.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CRU-Cu-China-2010Mar26.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 116084, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "March 2010                      15th March – 26th March  Spot premium for import cathode continues to decline   The spot premium for imported cathode saw a declining trend since the end of January 2010, with the  spot premium quotation now in the range of $60- 100/t.  Meanwhile, the premium for imported SXEW  cathode is quoted at $60-70/t.  Traders report that the import cathode spot market seems ", char_count: 7495});
CREATE (:Entity:Publication {id: "doc_5b7d4ccd5267", name_ru: "CRU-Cu-China-2010nov26.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CRU-Cu-China-2010nov26.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 198344, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "November 2010            © 2010 CRU International Limited confidential                    15th November – 26th November  Codelco sets its 2011 premium for China at $115/t  Codelco set its premium for China at $115/t in 2011, up by 35% y-o-y.  Its premium for South Korea will  rise by 32% to $98/t from $74/t this year and in Japan will also be $98/t, up from $75/t.  In Europe the  premium will adva", char_count: 9723});
