CREATE (:Entity:Publication {id: "doc_19dcea71b386", name_ru: "Гж 01_26.pdf", path: "Журналы/Горный журнал/2026/Гж 01_26.pdf", category: "Журналы", ext: "pdf", size_bytes: 12519780, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "1.2026 (№2342) 1.2026 (№2342) ОБЕСПЕЧЕНИЕ  УСТОЙЧИВОСТИ ГОРНЫХ  ВЫРАБОТОК –  ГАРАНТИЯ БЕЗОПАСНОСТИ  И ЭФФЕКТИВНОСТИ  ГОРНЫХ РАБОТ ОБЕСПЕЧЕНИЕ  УСТОЙЧИВОСТИ ГОРНЫХ  ВЫРАБОТОК –  ГАРАНТИЯ БЕЗОПАСНОСТИ  И ЭФФЕКТИВНОСТИ  ГОРНЫХ РАБОТ ОБЕСПЕЧЕНИЕ  УСТОЙЧИВОСТИ ГОРНЫХ  ВЫРАБОТОК –  ГАРАНТИЯ БЕЗОПАСНОСТИ  И ЭФФЕКТИВНОСТИ  ГОРНЫХ РАБОТ  Уважаемые коллеги! Фундаментальная горная наука в последние годы нахо", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_2e9f7faa2bf7", name_ru: "Гж 02_26.pdf", path: "Журналы/Горный журнал/2026/Гж 02_26.pdf", category: "Журналы", ext: "pdf", size_bytes: 6394710, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "2.2026 (№2343)   Уважаемые коллеги, друзья! В связи с 65-летием деятельности научно-исследовательского и проектного института «Якутнипроалмаз» сердечно поздравляю сотрудников и ветеранов этого уникального многопрофильного научно-технического подразделения Группы АЛРОСА. Накопленная институтом экспертиза является бесценным достоянием не только  алмазной, но и всей горной отрасли России. Суро", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_78278c4bc3ea", name_ru: "Гж 03_26.pdf", path: "Журналы/Горный журнал/2026/Гж 03_26.pdf", category: "Журналы", ext: "pdf", size_bytes: 6515168, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "3.2026 (№2344)  Уважаемые коллеги! Для «Горного журнала» с момента его основания и по настоящее время стало хорошей тра- дицией выносить на обсуждение экспертного сообщества актуальную информацию, связанную с  решением текущих и перспективных задач, стоящих перед горнодобывающей и перерабатывающей отраслями промышленности. Третий номер издания находится в общем тренде и полностью соот- ветствует э", char_count: 20000});
