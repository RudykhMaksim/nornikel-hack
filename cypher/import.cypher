CREATE (:Entity:Publication {id: "doc_8cd2c41ebad8", name_ru: "CM_10_2005sp.pdf", path: "Журналы/Цветные металлы/2005/CM_10_2005sp.pdf", category: "Журналы", ext: "pdf", size_bytes: 5602395, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "Содержание  За 50 лет деятельности учеными и инженерами Союзцветметавтоматики получено около 2000 авторских свидетельств и патентов. Более 40 разработок и выпускаемых изделий имеют полную патентную защиту. Только за период 2001–2005 гг. металлургическим предприятиям было поставлено более 10 000 приборов и систем управления. Получили широкое развитие работы по разработке аппаратуры, обеспечивающей ", char_count: 20000});
