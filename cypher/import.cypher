CREATE (:Entity:Publication {id: "doc_2a168767f9af", name_ru: "PreciousMetalsQuarterly2010JunExecSum.pdf", path: "Материалы конференций/Источники данных о МПГ/Квартальные издания/CRU/2010/June2010/PreciousMetalsQuarterly2010JunExecSum.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 117425, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Precious Metals Quarterly 2010 Q2  CRU International Limited confidential  Executive summary  Gold: prices to stay above $1,000/oz  The gold market’s fundamental surplus reached 1,554t in 2009 – more than double the 678t  seen in 2008 – as supply continued to run ahead of fabrication demand.  The surplus is expected  to remain large throughout the forecast period with a modest reduction expected", char_count: 11136});
