CREATE (:Entity:Publication {id: "doc_08c2d7557c9c", name_ru: "ОР 01_19.pdf", path: "Журналы/Обогащение руд/2019/ОР 01_19.pdf", category: "Журналы", ext: "pdf", size_bytes: 5718513, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ISSN 0202-3776 НАУЧНО-ТЕХНИЧЕСКИЙ ЖУРНАЛ. ИЗДАЕТСЯ С 1956 ГОДА www.rudmet.ru ПРИМЕНЕНИЕ KNELSON CVD-ТЕХНОЛОГИИ  ДЛЯ ОБОГАЩЕНИЯ ЗОЛОТО-СВИНЦОВОЙ РУДЫ  КОРРЕЛЯЦИЯ МЕЖДУ ИНДЕКСОМ  РАБОТЫ БОНДА (Wi) И ХИМИЧЕСКИМ  СОСТАВОМ ДЛЯ ФОСФАТНОЙ РУДЫ ЭНЕРГОЗАТРАТЫ В ВИБРАЦИОННЫХ  ТРАНСПОРТНО-ТЕХНОЛОГИЧЕСКИХ МАШИНАХ ОПРЕДЕЛЕНИЕ КОЭФФИЦИЕНТОВ  ВАРИАЦИИ МАССОВОЙ ДОЛИ  КОМПОНЕНТОВ В ПРОДУКТАХ ОБОГАЩЕНИЯ СОВЕРШЕНСТВ", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_bd4ce19b8e28", name_ru: "ОР 03_19.pdf", path: "Журналы/Обогащение руд/2019/ОР 03_19.pdf", category: "Журналы", ext: "pdf", size_bytes: 2089819, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "  НАУЧНО-ТЕХНИЧЕСКИЙ ЖУРНАЛ Основан в 1956 году. Издается один раз в 2 месяца. Санкт-Петербург Зарегистрирован Федеральной службой по надзору в сфере связи, информационных технологий и массовых коммуникаций (Роскомнадзор), ПИ № ФС77-51322 от 19 октября 2012 г.  УЧРЕДИТЕЛИ АО «Механобр инжиниринг» Научно-производственная корпорация «Механобр-техника» (АО) ФГАОУВО «Национальный исследовательский те", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_c6f783f0bb3e", name_ru: "ОР 04_19.pdf", path: "Журналы/Обогащение руд/2019/ОР 04_19.pdf", category: "Журналы", ext: "pdf", size_bytes: 1862404, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Реклама  ISSN 0202-3776 C О Д Е Р Ж А Н И Е ТЕХНОЛОГИЯ ОБОГАЩЕНИЯ Гильманшина Т. Р., Королева Г. А., Дьяконова В. Я., Капличенко Н. М. Разработка способов десульфурации скрытокристаллического  графита................................................................................................................ 3  ОБОГАТИТЕЛЬНЫЕ ПРОЦЕССЫ Элеш М. М., Эль-Мидани А. А., Абдель-Рахман М. К., Эль-Мофт", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_14367672af66", name_ru: "ОР 05_19.pdf", path: "Журналы/Обогащение руд/2019/ОР 05_19.pdf", category: "Журналы", ext: "pdf", size_bytes: 2322463, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " 23–27 сентября 2019 г. в г. Белгороде, РФ, с боль- шим успехом прошел 14-й Международный конгресс  по прикладной минералогии ICAM-2019. Конгресс про- водился на базе Белгородского государственного те- хнологического университета им. В. Г. Шухова. В нем  приняли участие более 400 ученых и специалистов со  всех континентов, в том числе 12 членов национальных  академий наук, доктора и кандидаты наук", char_count: 20000});
