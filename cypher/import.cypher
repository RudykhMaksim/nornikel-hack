CREATE (:Entity:Conclusion {id: "concl_lime_floor_limitation", name_ru: "Традиционная известковая нейтрализация ограничена остаточным сульфатом 1500-2500 мг/л из-за растворимости гипса и не позволяет достичь низких целевых значений (напр. ≤1000 мг/дм3)", name_en: "Traditional lime neutralization is capped at 1500-2500 mg/l residual sulfate (gypsum solubility) and cannot reach low targets (e.g. <=1000 mg/dm3)", geography: "Global", confidence: "verified", last_updated: "2025-07-01"});
CREATE (:Entity:Conclusion {id: "concl_savmin_meets_low_target", name_ru: "Процесс SAVMIN на пилотной установке (Stillfontein, ЮАР) снизил сульфат с 800 до <200 мг/л, т.е. может обеспечивать существенно более низкий сухой остаток, чем традиционное известкование", name_en: "SAVMIN pilot (Stillfontein, South Africa) reduced sulfate from 800 to <200 mg/l -- can reach far lower dry residue than traditional liming", geography: "International", confidence: "verified", last_updated: "2025-07-01"});
