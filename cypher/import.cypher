CREATE (:Entity:Publication {id: "doc_36eb5866d752", name_ru: "04_2005_CM.pdf", path: "Журналы/Цветные металлы/2005/04_2005_CM.pdf", category: "Журналы", ext: "pdf", size_bytes: 8962207, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "Содержание  Содержание  Е Ж Е М Е С Я Ч Н Ы Й  Н А У Ч Н О   Т Е Х Н И Ч Е С К И Й  И  П Р О И З В О Д С Т В Е Н Н Ы Й Ж У Р Н А Л Издательский дом «Руда и Металлы». Москва Журнал основан в 1926 г. а п р е л ь В. С. Александровская — отв. секретарь Н. В. Шаренко — ведущий редактор Т. С. Смирнова — ведущий редактор А. А. Матвеева — редактор Н. В. Андропова — редактор 4•2005 РЕДАКЦИОННАЯ КОЛЛЕГИЯ Гл", char_count: 20000});
