CREATE (:Entity:Publication {id: "doc_d17da5d5fe15", name_ru: "02_2005_cm.pdf", path: "Журналы/Цветные металлы/2005/02_2005_cm.pdf", category: "Журналы", ext: "pdf", size_bytes: 10915813, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "Содержание  Издательский дом «РУДА И МЕТАЛЛЫ» П редлагаем Вашему вниманию электронные версии журналов «Горный журнал», «Цветные металлы», «Черные металлы» и «Обогащение руд». При их создании используется программное обеспечение, полно стью отвечающее международным требованиям и поддерживающее все отечественные библиографические стандарты и форматы. Электронная продукция предназначена для применен", char_count: 20000});
