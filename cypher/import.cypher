CREATE (:Entity:Publication {id: "doc_534934058682", name_ru: "CopperMonitor2010MarEarthquakeSpecial.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperMonitor2010MarEarthquakeSpecial.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 80667, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "        © 2010 CRU International Limited confidential  Earthquake in Chile    On Monday 1st March, the copper price hit a 5-week peak of $7,600/t in early trading at the  LME due to supply worries following the 8.8 magnitude earthquake that hit Chile on Saturday  27th February 2010.  Most major copper operations are located in the northern regions.   Northern regions: CRU understands that roads ", char_count: 5728});
CREATE (:Entity:Publication {id: "doc_39b921760eef", name_ru: "CopperMonitor2010May.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperMonitor2010May.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 399215, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "May 2010        © 2010 CRU International Limited confidential  Copper stalls on Greek tragedy   Strong fluctuations in the value of the US dollar compared to other currencies  continue to affect the copper price, which had retreated from $8,000/t in early April to  around $7,700/t from 16th to 27th April, but then fell to $7,400/t at the time of writing.   Positive recovery prospects have so far", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_501006ad306b", name_ru: "CopperMonitor2010Nov.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperMonitor2010Nov.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 335795, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "November 2010        © 2010 CRU International Limited confidential  Copper heads back up to 2008 levels   Prices rose back to the highs last seen in 2008, supported by a weak dollar as well  as falling stocks across most exchanges.   Strike action at Collahuasi is a strong possibility as workers have rejected the latest  offer from the company.  This should support the price in the short term, a", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_7f64ce970ebd", name_ru: "CopperMonitor2010Sep.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperMonitor2010Sep.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 383675, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "September 2010        © 2010 CRU International Limited confidential  Oscillating between exuberance and fear   The seasonal downturn in copper consumption in Q3 has been less apparent than  usual, given the momentum of the recovery in industrial activity and some restocking  of both cathode and semis. This demand picture is detached from the erratic  sentiment about global economic prospects, whi", char_count: 20000});
