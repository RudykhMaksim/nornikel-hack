CREATE (:Entity:Publication {id: "doc_30582e64589a", name_ru: "Executive Summary October 2008.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-4Q2008-oct08/Executive Summary October 2008.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 341896, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Copper Quarterly Report October 2008  CRU International Limited confidential  Executive Summary  Copper Crumbles – the $64bn question   We have revised down our forecasts of both consumption and production from those  presented before LME Week in our Executive Preview to reflect the impact of financial  crisis on the real economy.    The refined copper market is expected to remain finely balan", char_count: 20000});
