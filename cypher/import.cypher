CREATE (:Entity:Publication {id: "doc_7cfb2ccb3cd2", name_ru: "CRU-Cu-monitor-15jan10.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CRU-Cu-monitor-15jan10.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 295959, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "January 2010        © 2009 CRU International Limited confidential  New Year uncertainty and volatility   After the upheaval of the global financial crisis, copper prices bounced back rapidly  fuelled by an active Chinese market through much of 2009.  However in the absence  of any marked recovery in the world ex-Asia, global exchange stocks have slowly  begun to accumulate, as Chinese buying slow", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_df8d89515fcf", name_ru: "CRU-Cu-monitor-25mar10.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CRU-Cu-monitor-25mar10.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 266767, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "April 2010        © 2010 CRU International Limited confidential  Looking for the green shoots of recovery   Spot cathode demand is picking up in Europe and the USA, partly due to seasonal  factors but we also believe some consumers may have been caught short.  Asian  demand is still strong, but there is now a little less optimism about China than at the  start of the year.   Cathode production c", char_count: 20000});
