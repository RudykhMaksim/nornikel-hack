CREATE (:Entity:Publication {id: "doc_2482a1f67a82", name_ru: "CopperMonitor2010-Oct.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperMonitor2010-Oct.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 403863, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "October 2010        © 2010 CRU International Limited confidential  $8,000/t and beyond…    Sentiment and prices have recovered strongly over the past month supported by  positive macro indicators, falling exchange stocks and little evidence of the seasonal  summer lull in demand in the northern hemisphere.   A weaker dollar and the latest supply news out of India add further upward bias to  copp", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_c2248703eb7a", name_ru: "CopperMonitor2010Apr.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperMonitor2010Apr.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 266767, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "April 2010        © 2010 CRU International Limited confidential  Looking for the green shoots of recovery   Spot cathode demand is picking up in Europe and the USA, partly due to seasonal  factors but we also believe some consumers may have been caught short.  Asian  demand is still strong, but there is now a little less optimism about China than at the  start of the year.   Cathode production c", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_e3094718eeb8", name_ru: "CopperMonitor2010Aug.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperMonitor2010Aug.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 320708, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "August 2010        © 2010 CRU International Limited confidential  Constrained    Refined demand is recovering quicker than expected, leading to a small deficit in Q2 as  copper refined production is performing well but not enough to meet immediate  consumption requirements.  Consumers and merchants face a lack of prompt material,  both cathode and scrap, leading to draw downs from exchange stocks", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_45566a3fd653", name_ru: "CopperMonitor2010Jul.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperMonitor2010Jul.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 287846, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "July 2010        © 2010 CRU International Limited confidential  Choppy copper in the face of financial  headwinds   Expectations for consumption are that Q3 will see the recovery continue.  Semi  fabricators are also facing a tight scrap market, with scrap traders unwilling to release  material bought when prices were higher, thus forcing scrap consumers into the  cathode market to make up the di", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_5678f5674598", name_ru: "CopperMonitor2010Jun.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperMonitor2010Jun.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 280386, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "June 2010        © 2010 CRU International Limited confidential  Froth blown away   Fears over sovereign debt in Europe and the ensuing risk aversion saw investors flee to  the relative safety of the US dollar.  As a result, a fall in copper prices to almost $6,400/t  on 20th May and a subsequent recovery to just $6,800-6,900/t at the time of writing has  blown away most of the froth that had buil", char_count: 20000});
