CREATE (:Entity:Publication {id: "doc_31d7d8ab3a8b", name_ru: "№ 05_24.pdf", path: "Журналы/Горный журнал/2024/№ 05_24.pdf", category: "Журналы", ext: "pdf", size_bytes: 10564760, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru Издается с 1825 года (№ 2322) 5.2024 ISSN 0017 2278    	   ! 	  		  Уважаемые работники и ветераны  Гайского горно-обогатительного комбината! От всей души поздравляю вас с 65-летним юбилеем нашего предприятия! Открытие и разработка Гайского медно-колчеданного месторождения стали мощным импульсом для развития горнодобывающей отрасли страны,", char_count: 20000});
