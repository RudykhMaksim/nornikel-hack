CREATE (:Entity:Publication {id: "doc_1b9b91571f24", name_ru: "N0105pdf.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/N0105pdf.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 180236, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 1st May 2009 Norilsk Nickel Daily News Digest Chrysler LLC, battered by collapsing U.S. sales and a global credit crisis, filed for bankruptcy and  announced an industry-changing deal with Fiat S.p.A. Despite intense negotiations over the past few  weeks, Chrysler failed to gain the full support from its lenders to avoid the first-ever bankruptcy filing by a  major U.S. automaker. Fiat w", char_count: 4400});
CREATE (:Entity:Publication {id: "doc_90ee2fd4afe6", name_ru: "N3004.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/N3004.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 201076, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 30th April 2009 Norilsk Nickel Daily News Digest President Barack Obama said he is hopeful that Chrysler LLC will be able to forge an alliance with Fiat   as it prepares for bankruptcy.  The president’s staff is aiming for Chrysler to file for Chapter 11 bankruptcy  protection as early as today to pave the way for Fiat to take a 20 percent stake in Chrysler. Chrysler’s best  assets would", char_count: 4379});
CREATE (:Entity:Publication {id: "doc_856598dd136b", name_ru: "NN0104.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN0104.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 185549, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 1st April 2009 Norilsk Nickel Daily News Digest President Barack Obama believes a quick, negotiated bankruptcy is the most likely way for GM to  restructure and become a competitive automaker, people familiar with the matter said. Obama said GM’s  and Chrysler’s recovery plans were insufficient. He gave GM 60 days to come up with deeper cost and  debt reductions than the biggest U.S. aut", char_count: 4213});
CREATE (:Entity:Publication {id: "doc_85bc90b492d6", name_ru: "NN0204.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN0204.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 187287, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 2nd April 2009 Norilsk Nickel Daily News Digest Ford and GM posted the sharpest declines among the major automakers as U.S. sales fell 36.8% in  March.  Ford’s sales dropped 42.1% and GM’s 44.7%- GM’s fifth slide of more than 40% in the past six  months. Chrysler sales tumbled 39.3%, its smallest percentage slide since October. The biggest Japanese  automakers all fell between 36 and 39%", char_count: 4297});
CREATE (:Entity:Publication {id: "doc_d501f8dddf56", name_ru: "NN0304.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN0304.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 184762, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 3rd April 2009 Norilsk Nickel Daily News Digest If GM is forced into bankruptcy, then a scenario that allows the company to divide assets into a “good”  GM and a “bad” GM may allow the automaker to make a swift reorganization, says Chairman Kent Kresa.   The good-bad model is “a great idea’’ and “a very good technique,” Kresa said. “It has its problems,  and all of our people are looking", char_count: 4140});
CREATE (:Entity:Publication {id: "doc_d97d0b776336", name_ru: "NN0501.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN0501.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 84645, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 5th January 2009 Norilsk Nickel Daily News Digest  Nkwe Platinum is poised to launch a long-awaited takeover bid for the rival platinum explorer  International Goldﬁelds.  International Goldﬁelds’s executive chairman, Tony Sage, said that the all-cash  offer was expected to value the target between $55.6 million and $68 million, or between 45c and 55c a  share. International Goldﬁelds en", char_count: 3726});
CREATE (:Entity:Publication {id: "doc_f4f448abdfc4", name_ru: "NN0601.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN0601.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 82631, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 6th January 2009 Norilsk Nickel Daily News Digest  U.S. auto sales plunged 36 percent in December, dragging the industry’s volume in 2008 to a 16-year  low as the recession ravaged demand. General Motors Corp.’s annual total was the smallest in its home  market since 1959.  Toyota Motor Corp. and Honda Motor Co. reported their ﬁrst drop in full-year U.S.  sales since the mid-1990s after ", char_count: 3465});
CREATE (:Entity:Publication {id: "doc_ea959f0de09b", name_ru: "NN0604.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN0604.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 185646, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 6th April 2009 Norilsk Nickel Daily News Digest Xstrata might be willing to sell its 25%stake in Lonmin Platinum as the group might see less potential for  integration with its own operations, Paul Cliff, an analyst with Nomura Securities, said.  Cliff said: “Clearly,  Xstrata is not a distressed seller and would only entertain attractive offers with a substantial premium.   We think the", char_count: 3959});
CREATE (:Entity:Publication {id: "doc_1aec1a797fcd", name_ru: "NN0701.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN0701.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 80081, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 7th January 2009 Norilsk Nickel Daily News Digest  Impala Platinum  announced today that it was continuing discussions with Mvelaphanda Resources and  Northam Platinum, for which it had formerly made a R21,2-billion cash-and-share bid.  The companies  announced in December that the transaction had been hampered as it could not determine an exchange  ratio for the deal, owing to the decli", char_count: 2400});
CREATE (:Entity:Publication {id: "doc_9484bba77b17", name_ru: "NN0801.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN0801.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 86012, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 8th January 2009 Norilsk Nickel Daily News Digest Platinum gained for a sixth day on speculation that plans to bolster the U.S. economy will support metal  demand. It jumped yesterday above $1,000/oz for the ﬁrst time in 12 weeks. U.S. President-elect Barack  Obama has proposed a $775 billion stimulus. The Treasury has pledged $13.4 billion to help General  Motors pay bills and $6 billio", char_count: 3989});
CREATE (:Entity:Publication {id: "doc_f0b4cf6042b3", name_ru: "NN0804.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN0804.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 181550, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 8th April 2009 Norilsk Nickel Daily News Digest Cash-strapped auto suppliers will be able to tap only $3.5 billion in federal aid, not the $5 billion  previously thought, because Ford won’t take its allocation of the funds.  In addition, GM will have to pay  $100 million into the supplier bailout program so its suppliers can access its share of the federal funds,  amounting to $2 billion", char_count: 4398});
CREATE (:Entity:Publication {id: "doc_a55c93009515", name_ru: "NN0901.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN0901.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 84274, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 9th January 2009 Norilsk Nickel Daily News Digest J.D. Power cut its 2009 western European auto market forecast by 600,000 units on Wednesday  following a bleak December sales month and now sees volumes down 16% for the full year to levels last  seen in 1993.  The automotive forecasting arm of J.D. Power expects sales of just 11.39 million vehicles in  western Europe.  Double-digit decli", char_count: 3592});
CREATE (:Entity:Publication {id: "doc_610ce057350e", name_ru: "NN0904.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN0904.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 184137, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 9th April 2009 Norilsk Nickel Daily News Digest The White House task force charged with retooling the U.S. auto industry is meeting with General  Motors officials to accelerate its restructuring process, an administration official said Wednesday.   Source:  Automotive News  Cash-strapped auto suppliers may be able to tap the full $5 billion in U.S. aid designated for their  relief, even ", char_count: 4313});
CREATE (:Entity:Publication {id: "doc_5491f7d7f7d1", name_ru: "NN1003.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN1003.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 86459, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 10th March 2009 Norilsk Nickel Daily News Digest  Platinum Australia says that the treatment plant at its Smokey Hills platinum mine in South Africa,  which produced its ﬁrst concentrates in late January, is now expected to ramp up to its 60,000t/month  design capacity.  In its interim report to end-December 2008, the company said that the treatment plant  is expected to reach design cap", char_count: 4438});
CREATE (:Entity:Publication {id: "doc_8935a8412f22", name_ru: "NN1103.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN1103.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 85162, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 11th March 2009 Norilsk Nickel Daily News Digest  Automobile sales in Brazil rose in February for the third straight month, helped by government tax  breaks that have allowed dealers to lower prices to woo consumers back into showrooms, the national  automakers’ association Anfavea said.  Sales of new cars and trucks edged up 1.0 % to 199,400 units,  following a 1.5 % increase in January", char_count: 3457});
CREATE (:Entity:Publication {id: "doc_ccc86aa8b9b4", name_ru: "NN1201.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN1201.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 95982, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 12th January 2009 Norilsk Nickel Daily News Digest Forecast 2009, the LBMA’s annual survey of opinions from precious metal participants on the direction of  prices for the coming year, has been released.   For platinum, GFMS’ Executive Chairman Philip Klapwijk  forecast for platinum a high of $1,440/oz and a low of $ 850/oz (average $1,090/oz) in 2009.  The  average prices given by 25 co", char_count: 3072});
CREATE (:Entity:Publication {id: "doc_b3987b0dbbc2", name_ru: "NN1203.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN1203.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 548840, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "   London, 12th March 2009 Norilsk Nickel Daily News Digest Ford Motor Co., the first U.S. automaker to reach a mid-contract union agreement, said labour  concessions will save about $375 million this year and allow consolidation of vehicle assembly between  two Michigan factories.  The automaker said contract changes ratified by the United Auto Workers union  on March 9 permit the use of stock to", char_count: 4442});
CREATE (:Entity:Publication {id: "doc_f34972a06db4", name_ru: "NN1301.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN1301.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 87499, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 13th January 2009 Norilsk Nickel Daily News Digest Chrysler LLC, saying it wants to avoid saddling dealers with unwanted vehicles, may extend a month- long production halt at some factories.  On Dec. 17, the company said it would stretch the holiday  shutdown at its North American plants until at least Jan. 19 after its U.S. sales fell 47 percent in  November. Chrysler volume then plunge", char_count: 4094});
CREATE (:Entity:Publication {id: "doc_50f43b65594c", name_ru: "NN1302.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN1302.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 85004, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 13th February 2009 Norilsk Nickel Daily News Digest Ridge Mining is in discussions with larger rival Aquarius Platinum that could lead to a takeover offer  being made for Ridge, the ﬁrm said on Thursday.  Shares in Ridge Mining leapt 50,8% on Thursday,  to 47,5p by 16:20 in London.  However, the company cautioned that there was no certainty over the  terms or structure of a potential tra", char_count: 4044});
CREATE (:Entity:Publication {id: "doc_4c65a0135f2d", name_ru: "NN1303.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN1303.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 193433, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 13th March 2009 Norilsk Nickel Daily News Digest Anooraq Resources’ financing strategy to buy certain South African platinum assets from Anglo Platinum  were at an advanced stage, the company said yesterday.  Anooraq and its biggest shareholder, Pelawan  Investments, are in talks on a financing strategy for the acquisition of 51% of the Lebowa platinum mine  and an additional 1% controll", char_count: 4309});
CREATE (:Entity:Publication {id: "doc_2caec4533a63", name_ru: "NN1404.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN1404.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 180741, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 14th April 2009 Norilsk Nickel Daily News Digest The federal government will buy about 17,600 fuel-efficient vehicles from the Detroit 3 by June 1,  including 2,500 hybrid sedans by April 15.  The purchases for the federal fleet will use $285 million of the  $300 million that Congress appropriated in its economic recovery act to buy new vehicles with better fuel  economy.  Though the rec", char_count: 4105});
