CREATE (:Entity:Publication {id: "doc_43fd06fc885b", name_ru: "2003_CM-MJ-sp.pdf", path: "Журналы/Цветные металлы/2003-2/2003_CM-MJ-sp.pdf", category: "Журналы", ext: "pdf", size_bytes: 27044073, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "Специальный выпуск 2003 Богатства древней земли Таджикистана — людям Содержание  Дорогие читатели! Таджикистан — это страна гор, 93 % ее территории составляют горы, которые таят в себе несметные минеральные богатства. Начало освоения природных богатств недр на территории Таджикистана относится к глубокой древности, о чем свидетельствуют следы горных выработок, археологические находки. Чтобы приумн", char_count: 20000});
