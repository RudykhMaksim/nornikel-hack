CREATE (:Entity:Publication {id: "doc_469d009100e7", name_ru: "CopperMonitor2011Apr.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2011/CopperMonitor2011Apr.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 360330, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "April 2011        © 2011 CRU International Limited confidential  Resilience   The copper price recovered from below $9,400/t in late February to almost $10,000/t  in early March only to slump to a low of $8,990/t on 15th March in the wake of the  crisis that hit Japan following the earthquake on 11th March.  The price has  recovered to trade in a $9,300-9,700/t range, as the impact of the disaste", char_count: 20000});
