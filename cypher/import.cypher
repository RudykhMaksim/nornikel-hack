CREATE (:Entity:Publication {id: "doc_34c133503d53", name_ru: "CM_04_18.pdf", path: "Журналы/Цветные металлы/2018/CM_04_18.pdf", category: "Журналы", ext: "pdf", size_bytes: 3856596, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru ISSN 0372-2929 ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 904)  4. 2018    Поздравляю Вас с успешным и достойным выбором  Национального Лидера — Президента России. Думаю, что новое  Правительство усилит работу по созданию благоприятных  условий для развития промышленности и мы вместе обеспечим  дальнейшее развитие производства в интересах нашего  О", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_052c9f024758", name_ru: "CM_05_18.pdf", path: "Журналы/Цветные металлы/2018/CM_05_18.pdf", category: "Журналы", ext: "pdf", size_bytes: 3574291, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Более 40 лет мне доверено редактировать раздел «Экономика  и управление производством» журнала «Цветные металлы». Но впервые  за эти годы появилась возможность обратиться непосредственно к вам,  нашим читателям. Конечно, каждый рецензент должен прежде всего ответить на вопрос:  «Является ли тема рецензируемой статьи новой и актуальной,  представляющей интерес для читателей нашего журнала?». И я, ", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_cf51b398efb8", name_ru: "ЦМ № 7-2018.pdf", path: "Журналы/Цветные металлы/2018-все/ЦМ № 7-2018.pdf", category: "Журналы", ext: "pdf", size_bytes: 5267069, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "Приаргунскому производственному горнохимическому объединению Приаргунскому производственному горнохимическому му объединен нению  5  Уважаемые читатели и коллеги! В 2018 г. исполнилось 50 лет со дня принятия постановления  Совета министров СССР о строительстве Приаргунского горно- хими ческого комбината на базе Стрельцовской группы урановых  месторождений. История этого предприятия началась в ", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_e789011118a2", name_ru: "ЦМ № 9-2018.pdf", path: "Журналы/Цветные металлы/2018-все/ЦМ № 9-2018.pdf", category: "Журналы", ext: "pdf", size_bytes: 4824594, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " УВАЖАЕМЫЕ КОЛЛЕГИ И ЧИТАТЕЛИ ЖУРНАЛА! Как всегда, осень богата на конференции, среди кото- рых важное место занимает Международный конгрес с  «Цветные металлы и минералы». Конгресс ежегодно про- водится в Красноярске в начале сентября. В этом году он  юбилейный — десятый. В рамках Конгресса состоялись  отраслевые конференции «Алюминий Сибири», «Золото  Сибири», «Металлургия цветных, благородных и", char_count: 20000});
