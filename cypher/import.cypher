CREATE (:Entity:Publication {id: "doc_000560b41575", name_ru: "ОР 05_18.pdf", path: "Журналы/Обогащение руд/2018/ОР 05_18.pdf", category: "Журналы", ext: "pdf", size_bytes: 2091372, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Уважаемые коллеги!   У металлургов была прекрасная традиция — из перво- го металла, выплавленного в печи, отливать памятные ме- дали, которые затем раздавались гостям, приехавшим на  торжественную церемонию. Такие медали, скорее всего,  остались в личных коллекциях. Журналы \"Цветные металлы\" и \"Чер- ные металлы\" обращаются к участникам и   гостям знаменательных событий с предложе- нием  передать ", char_count: 20000});
