CREATE (:Entity:Publication {id: "doc_e12d10ebe8fa", name_ru: "ГЖ_02_25.pdf", path: "Журналы/Горный журнал/2025/ГЖ_02_25.pdf", category: "Журналы", ext: "pdf", size_bytes: 7997580, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru Издается с 1825 года (№ 2331) 2.2025 ISSN 0017 2278 Центру геодинамической безопасности  Заполярного филиала  ПАО «ГМК «Норильский никель» – 35 лет (с. 5–13)     Дорогие читатели «Горного журнала», братья и сестры! Мне выпала высокая честь открыть номер журнала, который за все годы 200-летнего существования является полной и достоверной летописью истории развития горной промышленност", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_e548236d1ea1", name_ru: "ГЖ_03_25.pdf", path: "Журналы/Горный журнал/2025/ГЖ_03_25.pdf", category: "Журналы", ext: "pdf", size_bytes: 6135350, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru Издается с 1825 года (№ 2332) 3.2025 ISSN 00172278 XI Международная научно- практическая конференция  «Инновационные направления  в проектировании  горнодобывающих  предприятий»   Уважаемые читатели! В настоящем выпуске «Горного журнала» объединены статьи, подготов- ленные по итогам XI Международной научно-практической конференции «Инновационные направления в проектировании горнодоб", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_9ab4499af5ff", name_ru: "ГЖ_04_25.pdf", path: "Журналы/Горный журнал/2025/ГЖ_04_25.pdf", category: "Журналы", ext: "pdf", size_bytes: 6929286, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru Издается с 1825 года (№ 2333) 4.2025 ISSN 00172278 С Днём геолога! С Днём геолога!  Уважаемые читатели! В ваших руках новый номер «Горного журнала», наполненный разнообразными материалами, посвященными горному делу и геологии.  Открывает номер статья «Металлоносность кайнозойских углей Дальневосточ- ного региона Российской Федерации», в которой обобщены результаты иссле- дований Все", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_d758242c7e36", name_ru: "ГЖ_05_25.pdf", path: "Журналы/Горный журнал/2025/ГЖ_05_25.pdf", category: "Журналы", ext: "pdf", size_bytes: 5847423, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru Издается с 1825 года (№ 2334) 5.2025 ISSN 00172278 С ДНЕМ ПОБЕДЫ! 80  лет Памятник  «Геологам воинам 1941–1945»  на территории ВИМС  Уважаемые читатели, коллеги! Этот год – особенный. Наша страна и весь прогрессивный мир отмечает 80-летие Великой Победы – событие, которое навсегда изменило ход истории и определило судьбу России и мира. Восемьдесят лет прошло с того дня, когда над Ре", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_0beead37ff2e", name_ru: "ГЖ_06_25.pdf", path: "Журналы/Горный журнал/2025/ГЖ_06_25.pdf", category: "Журналы", ext: "pdf", size_bytes: 16311213, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "www.rudmet.ru Издается с 1825 года (№ 2335) 6.2025 ISSN 00172278 РЕКЛАМА  Дорогие коллеги! В этом году мы отмечаем знаковую дату — 90-летие со дня основания нашей компании. Девять десятилетий — это не просто цифра. Это история трудового подвига, смелых решений и бесконечной преданности делу, которое объеди- нило тысячи людей под знаменем промышленного прогресса. В далекие годы становления наш ком", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_21274f74b1b1", name_ru: "ГЖ_07_25.pdf", path: "Журналы/Горный журнал/2025/ГЖ_07_25.pdf", category: "Журналы", ext: "pdf", size_bytes: 42399708, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "  ОСНОВАН  В 1825 ГОДУ © Оформление. АО «Издательский дом «Руда и Металлы», «Гор ный жур нал», 2025 Базовый печатный орган Межправительственного совета по разведке, использованию и охране недр стран СНГ Журнал выпускается при участии: АО «Апатит», ПАО «ГМК «Норильский никель»  При содействии: Государственного Эрмитажа При консультативной и информационной поддержке Федеральной службы  по экологичес", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_0cabbe21b8c2", name_ru: "ГЖ_08_25.pdf", path: "Журналы/Горный журнал/2025/ГЖ_08_25.pdf", category: "Журналы", ext: "pdf", size_bytes: 6219370, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "   ОСНОВАН  В 1825 ГОДУ № 8 (2337)  АВГУСТ 2025 Подписной индекс в объединенном каталоге   «Пресса России» – 45343 Ежемесячный научно-технический   и производственный журнал  © Оформление. АО «Издательский дом «Руда и Металлы», «Гор ный жур нал», 2025 Издатель – АО «Издательский дом «Руда и Металлы» Адрес издателя: 119049, Москва, Ленинский просп., д. 6,  строение 2, НИТУ «МИСИС», оф. 622 А", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_9aece3f3060c", name_ru: "ГЖ_09_25.pdf", path: "Журналы/Горный журнал/2025/ГЖ_09_25.pdf", category: "Журналы", ext: "pdf", size_bytes: 13556486, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "9.2025 (№2338)  Дорогие ветераны,  уважаемые сотрудники, коллеги! 80 лет – это не просто дата. Это целая эпоха. Эпоха труда, преодоления, преемственности и высокой  ответственности. Сегодня мы отмечаем юбилей рудника «Заполярный» – предприятия, которое первым появилось на промышленной карте северного города. Уже тогда, в первые годы, было понятно: здесь непросто. Рудное тело залегает в сложных пор", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_8afd66e11305", name_ru: "ГЖ_10_25.pdf", path: "Журналы/Горный журнал/2025/ГЖ_10_25.pdf", category: "Журналы", ext: "pdf", size_bytes: 20097441, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: " Уважаемые читатели журнала! Представляем Вам очередной номер «Горного журнала», который посвящен проблемам горного дела, развитию минерально-сырьевой базы в сфере недропользования в современных условиях. Открывает номер статья «Анализ изменения гидрогеологических условий при отработке железорудных месторождений на территории Курской магнитной аномалии»,  в которой рассмотрены вопросы изучения гид", char_count: 20000});
