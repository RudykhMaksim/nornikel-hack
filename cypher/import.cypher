CREATE (:Entity:Publication {id: "doc_954b117ded5b", name_ru: "CopperQuarterly2011JulExecSum.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2011/CopperQuarterly2011JulExecSum.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 321825, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  Copper Quarterly July 2011  CRU International Limited confidential  Executive Summary  Waiting on the mine projects   The LME price fell towards $8,500/t in May, only to shrug off macroeconomic uncertainty and  recover to over $9,700/t by mid-July.  Global refined consumption grew q-on-q in Q2, due  to the usual seasonal factors.  Production, though, grew by less than half the rate of  consumpt", char_count: 20000});
