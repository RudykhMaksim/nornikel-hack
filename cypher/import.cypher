CREATE (:Entity:Publication {id: "doc_8bf2fd2fbda0", name_ru: "ЦМ 04-22.pdf", path: "Журналы/Цветные металлы/2022/ЦМ 04-22.pdf", category: "Журналы", ext: "pdf", size_bytes: 6883762, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "ISSN 0372-2929 www.rudmet.ru ЕЖЕМЕСЯЧНЫЙ НАУЧНО-ТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Издается с 1926 г. (№ 952)  4. 2022 Научные разработки Национального исследовательского Томского государственного университета в области науки и технологий редких и редкоземельных металлов и материалов на их основе (с. 4) С ДНЕМ КОСМОНАВТИКИ!  УВАЖАЕМЫЕ КОЛЛЕГИ! В этом номере представлены работы специалистов  Кол", char_count: 20000});
