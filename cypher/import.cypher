CREATE (:Entity:Publication {id: "doc_9aa465c7c1ac", name_ru: "NN2804.pdf", path: "Материалы конференций/Источники данных о МПГ/Дневные издания/GFMS/NN2804.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 180601, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "  London, 28th April 2009 Norilsk Nickel Daily News Digest General Motors has proposed handing a controlling stake of more than 50% to the US government.  The  nationalisation, in effect, of the biggest US motor manufacturer would be part of a huge debt-for-equity  swap as GM tries to shed $44bn (£30bn) of $62bn in crippling liabilities.  But the plan was condemned  as “neither reasonable nor adeq", char_count: 4282});
