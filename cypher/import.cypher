CREATE (:Entity:Publication {id: "doc_2d3e7216fa7c", name_ru: "CRU-Cu-wire-monit-4nov09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-wire-monit-4nov09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 696182, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "November 2009    Page 1 of 12  © 2009 CRU International Limited confidential  www.crugroup.com      Global Recovery is Underway   Our initial estimates for Q3 show that the modest improvement in the market that began to  show in Q2 has continued, and as a result we can say that at a global level the recovery in the  copper wirerod and wire and cable markets is now underway. This recovery is at pr", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_8c9707c8c24e", name_ru: "CRU-Cu-wire-monit-4sep09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-wire-monit-4sep09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 688216, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "September 2009    Page 1 of 12  © 2009 CRU International Limited confidential  www.crugroup.com      A Modest Improvement in Outlook   As more data has become available we have made some small revisions to our H1 data and  we now believe that the global copper wirerod market contracted by 11.4% rather than our  previous estimate of 11.8%. It is now clear that all the major markets around the worl", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_f7681cc23376", name_ru: "CRU-Cu-wire-monit-6may09.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-Cu-wire-monit-6may09.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 701293, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "May 2009    Page 1 of 12  © 2009 CRU International Limited confidential  www.crugroup.com      A Very Bad Start to 2009, With the Pain Set to Continue   In this issue are our initial estimates for the first quarter of 2009 and it doesn’t make pleasant  reading. Trade data for Q1 is still only patchy but it is clear that wirerod and wire and cable  volumes are well down across almost the whole wor", char_count: 20000});
