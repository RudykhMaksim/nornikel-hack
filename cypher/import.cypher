CREATE (:Entity:Patent {id: "patent_heavy_metals_lime", name_ru: "Патент «Способ очистки сточных вод от ионов тяжёлых металлов»", name_en: "Patent \"Method of wastewater treatment from heavy metal ions\"", geography: "RU", confidence: "verified", last_updated: "2025-01-01", description: "Обработка известковым молоком (известняк : негашёная известь = 1:10, 3,3% масс.) с принудительной подачей CO2 на стадии гашения извести для образования нерастворимых основных карбонатов металлов; отстаивание с доосветлением до pH~8 за счёт естественного поглощения CO2 из атмосферы."});
CREATE (:Entity:Patent {id: "patent_sulfate_barium_freeze", name_ru: "Патент «Способ очистки шахтных сточных вод от сульфатов»", name_en: "Patent \"Method of mine wastewater treatment from sulfates\"", geography: "RU", confidence: "verified", last_updated: "2025-01-01", description: "Двухступенчатая схема: вымораживание для концентрирования сульфатов, известкование до pH 10,5-11 (осаждение CaSO4), раздельная обработка потоков (щёлочь+Ba(OH)2 и HCl+BaCl2 до pH 4,0-4,5) с флокулянтом, объединение и осветление, карбонизация дымовыми газами до pH 8-8,5."});
