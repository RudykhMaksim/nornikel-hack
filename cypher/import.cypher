CREATE (:Entity:Publication {id: "doc_1cc213fee633", name_ru: "CopperChinaFortnightly2012Sep14.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2012/CRU-China reports/CopperChinaFortnightly2012Sep14.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 175521, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "September 2012            © 2012 CRU International Limited confidential                    3rd September– 14th September  Prices rebound, but market remains oversupplied    Domestic Chinese copper prices have rebounded sharply over the last fortnight with the SHFE 3-month price  trading at its highest level since May 2nd.  Spot prices as reported by SHMET rose every single day between  August 31st", char_count: 7728});
