CREATE (:Entity:Publication {id: "doc_069abf72cb92", name_ru: "12_2003_cm.pdf", path: "Журналы/Цветные металлы/2003/12_2003_cm.pdf", category: "Журналы", ext: "pdf", size_bytes: 5221058, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "12• 2003 12• 2003   ЕЖЕМЕСЯЧНЫЙ МЕЖДУНАРОДНЫЙ НАУЧНОDТЕХНИЧЕСКИЙ И ПРОИЗВОДСТВЕННЫЙ ЖУРНАЛ Содержание  Фирма была создана 10 лет назад и имеет солидный опыт и хорошую деловую репутацию в Венгрии, а также налаженные связи с рядом фирм Центральной Европы. Помимо этого, про$ водится аудит венгерских алюминиевых предприятий. Фирма “Deputatus” предлагает следующие услуги  в Ве", char_count: 20000});
