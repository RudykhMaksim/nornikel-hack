CREATE (:Entity:Publication {id: "doc_0bec075973f9", name_ru: "10_2005_CM.pdf", path: "Журналы/Цветные металлы/2005/10_2005_CM.pdf", category: "Журналы", ext: "pdf", size_bytes: 10976260, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "RU", snippet: "Содержание  Коллективу Заполярного филиала ГМК «Норильский никель» Дорогие друзья! Норильский комбинат имеет легендарную историю. Его 70летний путь отмечен большими достижениями и высокими наградами. В годы Великой Отечественной войны в невероятно тяжелых условиях, в сжатые сроки был получен первый норильский никель  стратегический металл, который был основой знаменитой русской танковой брони. С", char_count: 20000});
