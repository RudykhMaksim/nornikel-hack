CREATE (:Entity:Publication {id: "doc_8dc26ff63c91", name_ru: "CopperQuarterly2010Oct.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperQuarterly2010OctReport.zip::CopperQuarterly2010Oct.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 7368493, sensitivity: "public", confidence: "verified", deep_parsed: false, geography: "International"});
CREATE (:Entity:Publication {id: "doc_f7cc7aadf45b", name_ru: "CopperSouthAmericaMonthly2010Mar.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperSouthAmericaMonthly2010Mar.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 174693, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "March 2010          © 2010 CRU International Limited confidential    Earthquakes in Chile   CRU’s thoughts and condolences go out to our colleagues and people of Chile affected by the recent  earthquake and tremors. Chile is world’s largest copper producer and accounts for around 35% of global  mine output.  In 2009, Chilean copper mine production was 5.36Mt of which 3.25Mt was copper-in- concentr", char_count: 19181});
CREATE (:Entity:Publication {id: "doc_ccc45850afe7", name_ru: "CopperWireCableAndWirerodMonitor2010-13January.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperWireCableAndWirerodMonitor2010-13January.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 708430, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "January 2010    Page 1 of 12  © 2010 CRU International Limited confidential  www.crugroup.com      Recovery Continues in Q4, But Still a Long Way to Go   The recovery that we saw beginning in Q3 at a global level has continued in Q4 with copper  cable consumption falling by 3.5% in Q4 compared to 4.4% in Q3. Of course Q4 2008 was  very weak, and this has helped the year-on-year comparison, but we", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_33dbbf112e82", name_ru: "CopperWireCableAndWirerodMonitor2010Jul.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CopperWireCableAndWirerodMonitor2010Jul.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 714413, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "July 2010    Page 1 of 12  © 2010 CRU International Limited confidential  www.crugroup.com      Recovery Still Proving to be Patchy   This is the last issue of this monitor and over the more than ten years that it has been  published the cable industry has been through many changes. The most dramatic has been  the slump that started in Q4 2008 and despite the fact that the recovery has been under", char_count: 20000});
CREATE (:Entity:Publication {id: "doc_0cc6547ea230", name_ru: "CRU-Brochure - Copper Long-Term Outlook 2010.pdf", path: "Материалы конференций/Источники данных о меди/CRU/CRU-2010/CRU-Brochure - Copper Long-Term Outlook 2010.pdf", category: "Материалы конференций", ext: "pdf", size_bytes: 527991, sensitivity: "public", confidence: "verified", deep_parsed: true, geography: "International", snippet: "ACCURATE ANALYTICAL AUTHORITATIVe ...FROM CRU’S LEADING  RANGE OF COPPER  FORECASTS www.crugroup.com Copper  long-term OUTLOOK  EXPERT RESEARCH EXPERT OPINION new  2010 edition  the essential  resource FOR   the copper  market In the last 12 months, the global copper market has  rebounded more quickly than anybody expected.  We have  a market fuelled by real consumption, disciplined production  gr", char_count: 10371});
